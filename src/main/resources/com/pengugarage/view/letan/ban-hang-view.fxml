<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- MÀN HÌNH BÁN HÀNG & PHỤ TÙNG (POS BÁN LẺ)                             -->
<!-- (ban-hang-view.fxml)                                                  -->
<!-- Tone màu: Light Modern UI đồng bộ hệ thống Pengu Garage               -->
<!-- - Brand Navy: #102A46 / #173B61                                       -->
<!-- - Action Orange: #F47B31                                              -->
<!-- - Canvas xám nhạt: #F4F7FA, Surface trắng: #FFFFFF                    -->
<!-- ===================================================================== -->

<VBox prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.BanHangController">

    <!-- 1. Thanh Header Lễ Tân bên trên (Các đề mục lớn) -->
    <fx:include source="component/header-letan.fxml" />

    <!-- 2. Thân Trang: Sidebar đóng mở bên trái + Vùng làm việc POS Bán Hàng -->
    <HBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

        <!-- Sidebar bên trái (Đóng mở linh hoạt) -->
        <fx:include source="component/sidebar-letan.fxml" />

        <!-- 3. VÙNG LÀM VIỆC BÁN HÀNG CHÍNH (POS) -->
        <HBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

            <!-- CỘT TRÁI: TÌM KIẾM, GIỎ HÀNG VÀ MENU SẢN PHẨM KÉO MỞ/THU GỌN -->
            <VBox HBox.hgrow="ALWAYS" spacing="10.0" style="-fx-padding: 12px 14px 12px 16px;">

                <!-- 3.1. Hàng trên: Thanh tìm kiếm sản phẩm lớn + Tabs đa hóa đơn -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <!-- Ô tìm kiếm và quét mã barcode F3 -->
                    <TextField fx:id="txtTimKiemSanPham"
                               promptText="🔍 Nhập tên hoặc quét mã vạch sản phẩm (F3)..."
                               HBox.hgrow="ALWAYS"
                               styleClass="pos-search-field" />

                    <!-- Các Tab Hóa đơn (Đa đơn cùng lúc) -->
                    <HBox fx:id="boxTabsHoaDon" alignment="BOTTOM_LEFT" spacing="4.0" />

                    <!-- Nút thêm Hóa đơn mới (+) -->
                    <Button fx:id="btnThemHoaDon" text="+" onAction="#onThemHoaDonClick"
                            styleClass="pos-tab-add-btn" />
                </HBox>

                <!-- 3.2. Bảng Giỏ Hàng (Chi tiết sản phẩm đã chọn) -->
                <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px;">
                    <TableView fx:id="tableGioHang" VBox.vgrow="ALWAYS" styleClass="light-table">
                        <columns>
                            <TableColumn fx:id="colSTT" prefWidth="42.0" text="#" style="-fx-alignment: CENTER;" />
                            <TableColumn fx:id="colMaSP" prefWidth="105.0" text="Mã" style="-fx-alignment: CENTER_LEFT;" />
                            <TableColumn fx:id="colTenSP" prefWidth="250.0" text="Tên sản phẩm" style="-fx-alignment: CENTER_LEFT;" />
                            <TableColumn fx:id="colDVT" prefWidth="75.0" text="ĐVT" style="-fx-alignment: CENTER;" />
                            <TableColumn fx:id="colDonGia" prefWidth="110.0" text="Đơn giá" style="-fx-alignment: CENTER_RIGHT;" />
                            <TableColumn fx:id="colSoLuong" prefWidth="115.0" text="Số lượng" style="-fx-alignment: CENTER;" />
                            <TableColumn fx:id="colThanhTien" prefWidth="125.0" text="Thành tiền" style="-fx-alignment: CENTER_RIGHT;" />
                            <TableColumn fx:id="colThaoTac" prefWidth="65.0" text="Xóa" style="-fx-alignment: CENTER;" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 30px;">
                                <Label text="🛒" style="-fx-font-size: 32px;" />
                                <Label text="Chưa có sản phẩm trong đơn hàng"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: 700;" />
                                <Label text="Chọn từ menu sản phẩm bên dưới hoặc quét mã vạch để thêm nhanh"
                                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- 3.3. Ngăn kéo Menu sản phẩm ở dưới đáy (Collapsible Product Drawer) -->
                <VBox fx:id="drawerSanPham" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(16,42,70,0.04), 8, 0, 0, 2);">

                    <!-- Header ngăn kéo: Chọn danh mục bằng ComboBox + Nút mũi tên kéo mở/thu gọn -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="pos-drawer-header">
                        <Label text="DANH MỤC:" style="-fx-text-fill: #64748b; -fx-font-size: 11.5px; -fx-font-weight: 900; -fx-letter-spacing: 0.5px;" />
                        <ComboBox fx:id="cboDanhMucSanPham" prefWidth="250.0" promptText="-- Tất cả danh mục --"
                                  styleClass="light-combo-box" />

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Nút Mũi Tên Kéo Lên / Kéo Xuống Ngăn Kéo Sản Phẩm -->
                        <Button fx:id="btnToggleDrawer" onAction="#onToggleDrawerClick"
                                text="▼ Thu nhỏ" styleClass="pos-drawer-toggle-btn" />
                    </HBox>

                    <!-- Danh sách lưới thẻ sản phẩm (Bấm thẻ để thêm ngay vào giỏ hàng) -->
                    <ScrollPane fx:id="scrollSanPham" fitToWidth="true" prefHeight="205.0" minHeight="0"
                                style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;">
                        <FlowPane fx:id="flowSanPham" hgap="10.0" vgap="10.0"
                                  style="-fx-padding: 10px; -fx-background-color: #f8fafc;" />
                    </ScrollPane>
                </VBox>

            </VBox>

            <!-- CỘT PHẢI: THÔNG TIN KHÁCH HÀNG & BẢNG TÍNH TIỀN THANH TOÁN -->
            <VBox prefWidth="350.0" minWidth="330.0" maxWidth="380.0" spacing="12.0" styleClass="pos-checkout-panel">

                <!-- Tiêu đề cột thanh toán -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="THÔNG TIN THANH TOÁN" style="-fx-text-fill: #102A46; -fx-font-size: 14.5px; -fx-font-weight: 900; -fx-letter-spacing: 0.5px;" />
                </HBox>

                <!-- Box Khách hàng: Tìm theo Số điện thoại -->
                <VBox spacing="8.0" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px 12px;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="KHÁCH HÀNG" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: 800;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnThemKhachHang" text="+ Thêm mới" onAction="#onThemKhachHangClick"
                                style="-fx-background-color: transparent; -fx-text-fill: #f47b31; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;" />
                    </HBox>

                    <!-- Ô tìm kiếm số điện thoại -->
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <TextField fx:id="txtTimKiemKhachHang" promptText="📞 Nhập số điện thoại khách hàng..." HBox.hgrow="ALWAYS"
                                   style="-fx-font-size: 12.5px; -fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 10px;" />
                        <Button fx:id="btnTimKhachHang" text="Tìm" onAction="#onTimKhachHangClick"
                                style="-fx-background-color: #102A46; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 6px 12px; -fx-cursor: hand;" />
                    </HBox>

                    <!-- Thẻ hiển thị khách hàng đã chọn -->
                    <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 10px;">
                        <Label text="👤" style="-fx-font-size: 13px;" />
                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblTenKhachHang" text="Khách lẻ (Vãng lai)" style="-fx-font-weight: 700; -fx-text-fill: #102A46; -fx-font-size: 12px;" />
                            <Label fx:id="lblSdtKhachHang" text="Mua trực tiếp tại quầy" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                        </VBox>
                        <Button fx:id="btnXoaChonKhachHang" text="✕" onAction="#onXoaChonKhachHangClick"
                                style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 2px 4px;" />
                    </HBox>
                </VBox>

                <!-- Box Chi tiết thanh toán & Tiền -->
                <VBox spacing="10.0" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 12px 14px;" VBox.vgrow="ALWAYS">
                    
                    <!-- Tổng tiền hàng -->
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Tổng tiền hàng:" styleClass="pos-summary-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTongTienHang" text="0 đ" styleClass="pos-summary-value" />
                    </HBox>

                    <!-- Khuyến mãi (Chọn mã từ DB) -->
                    <VBox spacing="5.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Mã khuyến mãi:" styleClass="pos-summary-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTienKhuyenMai" text="- 0 đ" style="-fx-text-fill: #ef4444; -fx-font-size: 13px; -fx-font-weight: 700;" />
                        </HBox>
                        <ComboBox fx:id="cboKhuyenMai" promptText="-- Chọn mã khuyến mãi --" maxWidth="Infinity" styleClass="light-combo-box" />
                    </VBox>

                    <Region style="-fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;" />

                    <!-- Khách cần trả (Nổi bật cam thương hiệu) -->
                    <HBox alignment="CENTER_LEFT">
                        <Label text="KHÁCH CẦN TRẢ:" styleClass="pos-summary-total-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblKhachCanTra" text="0 đ" styleClass="pos-summary-total-value" />
                    </HBox>

                    <!-- Tiền khách đưa -->
                    <VBox spacing="4.0">
                        <Label text="Tiền khách đưa (VNĐ):" styleClass="pos-summary-label" />
                        <TextField fx:id="txtTienKhachDua" promptText="Nhập số tiền khách đưa..."
                                   style="-fx-font-size: 13.5px; -fx-font-weight: 700; -fx-padding: 8px 12px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
                    </VBox>

                    <!-- Tiền thừa trả khách -->
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Tiền thừa trả khách:" styleClass="pos-summary-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTienThua" text="0 đ" style="-fx-text-fill: #059669; -fx-font-size: 14.5px; -fx-font-weight: 900;" />
                    </HBox>

                    <Region style="-fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;" />

                    <!-- Phương thức thanh toán -->
                    <VBox spacing="6.0">
                        <Label text="PHƯƠNG THỨC THANH TOÁN:" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: 800;" />
                        <HBox spacing="16.0">
                            <RadioButton fx:id="rbTienMat" text="💵 Tiền mặt" selected="true" style="-fx-font-weight: 700; -fx-font-size: 12.5px;" />
                            <RadioButton fx:id="rbChuyenKhoan" text="💳 Chuyển khoản (QR)" style="-fx-font-weight: 700; -fx-font-size: 12.5px;" />
                        </HBox>
                    </VBox>

                    <!-- Ghi chú đơn hàng -->
                    <VBox spacing="4.0">
                        <Label text="GHI CHÚ ĐƠN HÀNG:" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: 800;" />
                        <TextArea fx:id="txtGhiChu" promptText="Ghi chú thêm về đơn hàng..." prefRowCount="2"
                                  style="-fx-font-size: 12px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;" />
                    </VBox>
                </VBox>

                <!-- Các nút hành động chính -->
                <VBox spacing="8.0">
                    <!-- Nút Thanh toán lớn (Action Orange #F47B31) -->
                    <Button fx:id="btnThanhToan" text="⚡ THANH TOÁN &amp; IN HÓA ĐƠN"
                            maxWidth="Infinity" onAction="#onThanhToanClick"
                            styleClass="action-button"
                            style="-fx-font-size: 14px; -fx-font-weight: 900; -fx-padding: 12px;" />

                    <!-- Cặp nút In tạm tính & Hủy đơn -->
                    <HBox spacing="8.0">
                        <Button fx:id="btnInTamTinh" text="🖨️ In tạm tính" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                onAction="#onInTamTinhClick"
                                styleClass="secondary-button" style="-fx-font-size: 12px; -fx-padding: 8px 10px;" />
                        <Button fx:id="btnHuyDon" text="❌ Hủy đơn" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                onAction="#onHuyDonClick"
                                style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 8px; -fx-border-color: #fca5a5; -fx-border-radius: 8px; -fx-cursor: hand; -fx-padding: 8px 10px;" />
                    </HBox>
                </VBox>

            </VBox>

        </HBox>

    </HBox>

</VBox>

