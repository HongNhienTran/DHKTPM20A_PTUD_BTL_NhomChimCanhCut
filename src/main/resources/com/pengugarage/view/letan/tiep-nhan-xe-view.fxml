<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- MÀN HÌNH TIẾP NHẬN XE VÀO XƯỞNG (tiep-nhan-xe-view.fxml)             -->
<!-- Phục vụ cho Lễ tân, Cố vấn dịch vụ - GIAI ĐOẠN 1                      -->
<!-- Tone màu: Light Modern UI, Active Brand Navy #173B61                  -->
<!-- ===================================================================== -->

<VBox prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.TiepNhanXeController">

    <!-- 1. Header Lễ Tân bên trên -->
    <fx:include source="component/header-letan.fxml" />

    <!-- 2. Thân Trang: Sidebar đóng mở bên trái + Vùng nội dung chính -->
    <HBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

        <!-- Sidebar Lễ Tân bên trái -->
        <fx:include source="component/sidebar-letan.fxml" />

        <!-- Vùng Nội Dung Làm Việc Chính -->
        <VBox spacing="14.0" style="-fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
            </padding>

            <!-- 2.1. Top Title Bar & Nút Thao Tác -->
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #102A46; -fx-font-size: 24px; -fx-font-weight: 900;"
                           text="Tiếp Nhận Xe" />
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px;"
                           text="Giai đoạn 1: Tiếp nhận phương tiện, kiểm tra hiện trạng bàn giao ban đầu và đưa xe vào hàng đợi xưởng" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Badge tổng số xe tiếp nhận -->
                <Label fx:id="lblTongSoTiepNhan"
                       style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-padding: 6px 14px; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 13.5px;"
                       text="🚗 Tiếp nhận hôm nay: 0 xe" />

                <!-- Nút Làm Mới -->
                <Button fx:id="btnLamMoi" onAction="#onLamMoiClick"
                        style="-fx-background-color: #102A46; -fx-text-fill: #ffffff; -fx-font-weight: 700; -fx-font-size: 13.5px; -fx-padding: 8px 16px; -fx-background-radius: 8px; -fx-cursor: hand;"
                        text="🔄 Làm Mới" />
            </HBox>

            <!-- 2.2. Metric Cards Thống Kê Nhanh Tiến Độ Xe -->
            <HBox spacing="14.0">
                <!-- Card 1: Chờ kiểm tra -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-padding: 12px 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 4, 0, 0, 1);">
                    <Label style="-fx-font-size: 24px; -fx-background-color: #eff6ff; -fx-padding: 8px 12px; -fx-background-radius: 8px;" text="⏳" />
                    <VBox spacing="2.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-weight: 600;" text="Chờ Kiểm Tra Chẩn Đoán" />
                        <Label fx:id="lblChoKiemTra" style="-fx-text-fill: #2563eb; -fx-font-size: 20px; -fx-font-weight: 800;" text="0 xe" />
                    </VBox>
                </HBox>

                <!-- Card 2: Đang kiểm tra / Chờ báo giá -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-padding: 12px 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 4, 0, 0, 1);">
                    <Label style="-fx-font-size: 24px; -fx-background-color: #fff7ed; -fx-padding: 8px 12px; -fx-background-radius: 8px;" text="🔍" />
                    <VBox spacing="2.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-weight: 600;" text="Đang Kiểm Tra &amp; Báo Giá" />
                        <Label fx:id="lblDangKiemTra" style="-fx-text-fill: #ea580c; -fx-font-size: 20px; -fx-font-weight: 800;" text="0 xe" />
                    </VBox>
                </HBox>

                <!-- Card 3: Đang sửa chữa (Orange tone) -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-padding: 12px 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 4, 0, 0, 1);">
                    <Label style="-fx-font-size: 24px; -fx-background-color: #fff7ed; -fx-padding: 8px 12px; -fx-background-radius: 8px;" text="🔧" />
                    <VBox spacing="2.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-weight: 600;" text="Đang Sửa Chữa Tại Xưởng" />
                        <Label fx:id="lblDangSuaChua" style="-fx-text-fill: #ea580c; -fx-font-size: 20px; -fx-font-weight: 800;" text="0 xe" />
                    </VBox>
                </HBox>

                <!-- Card 4: Hoàn thành / Chờ giao xe -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-padding: 12px 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 4, 0, 0, 1);">
                    <Label style="-fx-font-size: 24px; -fx-background-color: #f0fdf4; -fx-padding: 8px 12px; -fx-background-radius: 8px;" text="✅" />
                    <VBox spacing="2.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-weight: 600;" text="Hoàn Thành Chờ Bàn Giao" />
                        <Label fx:id="lblHoanThanh" style="-fx-text-fill: #059669; -fx-font-size: 20px; -fx-font-weight: 800;" text="0 xe" />
                    </VBox>
                </HBox>
            </HBox>

            <!-- 2.3. Khu Vực Làm Việc Chính: Danh Sách Tiếp Nhận (Trái) + Form Tiếp Nhận (Phải) -->
            <HBox spacing="14.0" VBox.vgrow="ALWAYS">

                <!-- BẢNG DANH SÁCH PHIẾU TIẾP NHẬN (BÊN TRÁI) -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-padding: 14px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 4, 0, 0, 1);">

                    <!-- Thanh Tìm Kiếm & Bộ Lọc Nhanh -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <TextField fx:id="txtTimKiem" promptText="🔍 Tìm kiếm biển số xe, mã phiếu, tên/SĐT khách..."
                                   style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 7px 12px; -fx-font-size: 13.5px;"
                                   HBox.hgrow="ALWAYS" />

                        <ComboBox fx:id="cboLocTrangThai" prefWidth="180.0" promptText="-- Trạng thái --"
                                  style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 4px 6px; -fx-font-size: 13.5px;" />

                        <Button fx:id="btnTimKiem" onAction="#onTimKiemClick"
                                style="-fx-background-color: #102A46; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 7px 14px; -fx-background-radius: 6px; -fx-cursor: hand;"
                                text="Tìm" />

                        <Button fx:id="btnXoaLoc" onAction="#onXoaLocClick"
                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 7px 12px; -fx-background-radius: 6px; -fx-cursor: hand;"
                                text="Đặt lại" />
                    </HBox>

                    <!-- TableView Danh Sách Phiếu Tiếp Nhận -->
                    <TableView fx:id="tblPhieuTiepNhan" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: #f1f5f9; -fx-border-radius: 6px;">
                        <columns>
                            <TableColumn fx:id="colStt" prefWidth="45.0" style="-fx-alignment: CENTER;" text="STT" />
                            <TableColumn fx:id="colMaTiepNhan" prefWidth="125.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;" text="Mã Tiếp Nhận" />
                            <TableColumn fx:id="colBienSo" prefWidth="105.0" style="-fx-alignment: CENTER; -fx-font-weight: bold; -fx-text-fill: #102a46;" text="Biển Số Xe" />
                            <TableColumn fx:id="colMauXe" prefWidth="130.0" text="Hãng / Mẫu Xe" />
                            <TableColumn fx:id="colKhachHang" prefWidth="150.0" text="Khách Hàng" />
                            <TableColumn fx:id="colSoDienThoai" prefWidth="105.0" style="-fx-alignment: CENTER;" text="Số Điện Thoại" />
                            <TableColumn fx:id="colThoiGianVao" prefWidth="135.0" style="-fx-alignment: CENTER;" text="Thời Gian Vào" />
                            <TableColumn fx:id="colTrangThai" prefWidth="135.0" style="-fx-alignment: CENTER;" text="Trạng Thái" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <!-- Footer Table -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 4px 0 0 0;">
                        <Label fx:id="lblSoBanGhi" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Hiển thị 0 phiếu tiếp nhận" />
                    </HBox>
                </VBox>

                <!-- FORM TIẾP NHẬN XE (BÊN PHẢI) -->
                <VBox prefWidth="440.0" minWidth="410.0" spacing="12.0"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-padding: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 4, 0, 0, 1);">

                    <!-- Header Form -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblFormTieuDe"
                                   style="-fx-text-fill: #102A46; -fx-font-size: 17.5px; -fx-font-weight: 800;"
                                   text="Phiếu Tiếp Nhận Xe" />
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12.5px;"
                                   text="Ghi nhận thông tin xe và tình trạng ban đầu" />
                        </VBox>
                        <Label fx:id="lblBadgeMaTiepNhan"
                               style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8; -fx-padding: 4px 10px; -fx-background-radius: 8px; -fx-font-weight: bold; -fx-font-size: 12.5px;"
                               text="Tạo mới" />
                    </HBox>

                    <Separator />

                    <!-- Form Content Trong ScrollPane -->
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                        <VBox spacing="12.0" style="-fx-padding: 2px 4px 6px 2px;">

                            <!-- 1. Tra cứu / Chọn xe và chủ xe -->
                            <VBox spacing="6.0" style="-fx-background-color: #f8fafc; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                <Label style="-fx-text-fill: #102A46; -fx-font-weight: 700; -fx-font-size: 13.5px;" text="🚗 1. Thông Tin Xe &amp; Khách Hàng" />
                                
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <TextField fx:id="txtBienSoXe" promptText="Nhập biển số xe (VD: 51H-12345)..."
                                               style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 7px 10px; -fx-font-size: 13.5px; -fx-font-weight: bold;"
                                               HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnTimXe" onAction="#onTimXeClick"
                                            style="-fx-background-color: #102A46; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 7px 14px; -fx-background-radius: 6px; -fx-cursor: hand;"
                                            text="🔍 Tra Cứu" />
                                    <Button fx:id="btnThemPhuongTien" onAction="#onThemPhuongTienClick"
                                            style="-fx-background-color: #059669; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 7px 12px; -fx-background-radius: 6px; -fx-cursor: hand;"
                                            text="➕" />
                                </HBox>

                                <!-- Card tóm tắt xe & chủ xe -->
                                <VBox spacing="3.0" style="-fx-background-color: #ffffff; -fx-padding: 8px 10px; -fx-background-radius: 6px; -fx-border-color: #f1f5f9; -fx-border-radius: 6px;">
                                    <Label fx:id="lblThongTinXe" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 13.5px;" text="Phương tiện: Chưa chọn xe" />
                                    <Label fx:id="lblThongTinKhach" style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;" text="Chủ xe: -" />
                                </VBox>
                            </VBox>

                            <!-- 2. Thông số tiếp nhận -->
                            <VBox spacing="8.0">
                                <Label style="-fx-text-fill: #102A46; -fx-font-weight: 700; -fx-font-size: 13.5px;" text="📋 2. Thông Số Bàn Giao Xe" />

                                <GridPane hgap="10.0" vgap="8.0">
                                    <!-- Số KM hiện tại -->
                                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill: #475569; -fx-font-size: 12.5px; -fx-font-weight: 600;" text="Số ODO / KM Hiện Tại (*)" />
                                        <TextField fx:id="txtSoKM" promptText="VD: 45000"
                                                   style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 7px 10px; -fx-font-size: 13.5px;" />
                                    </VBox>

                                    <!-- Số lượng chìa khóa -->
                                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="120.0">
                                        <Label style="-fx-text-fill: #475569; -fx-font-size: 12.5px; -fx-font-weight: 600;" text="Số Chìa Khóa (*)" />
                                        <TextField fx:id="txtSoChiaKhoa" text="1" promptText="1"
                                                   style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 7px 10px; -fx-font-size: 13.5px; -fx-alignment: CENTER;" />
                                    </VBox>
                                </GridPane>

                                <!-- Kỹ thuật viên phụ trách kiểm tra xe ban đầu -->
                                <VBox spacing="4.0">
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 12.5px; -fx-font-weight: 600;" text="👨‍🔧 Kỹ Thuật Viên Phụ Trách Kiểm Tra Xe (*)" />
                                    <ComboBox fx:id="cboKyThuatVien" maxWidth="Infinity" promptText="-- Chọn kỹ thuật viên kiểm tra xe --"
                                              style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-font-size: 13.5px;" />
                                </VBox>

                                <!-- Yêu cầu ban đầu của khách hàng -->
                                <VBox spacing="4.0">
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 12.5px; -fx-font-weight: 600;" text="Yêu Cầu / Hiện Tượng Hỏng Hóc Của Khách (*)" />
                                    <TextArea fx:id="txtYeuCauKhach" prefRowCount="3" promptText="VD: Bảo dưỡng định kỳ 40.000 km, kiểm tra tiếng kêu lục cục dưới gầm khi qua gờ giảm tốc..."
                                              style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-font-size: 13px;" wrapText="true" />
                                </VBox>

                                <!-- Tình trạng ngoại thất xe -->
                                <VBox spacing="4.0">
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 12.5px; -fx-font-weight: 600;" text="Tình Trạng Ngoại Thất (Trầy xước, đèn, gương, kính...)" />
                                    <TextArea fx:id="txtTinhTrangNgoaiThat" prefRowCount="2" promptText="VD: Cản trước trầy nhẹ bên phụ, đèn hậu nguyên vẹn..."
                                              style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-font-size: 13px;" wrapText="true" />
                                </VBox>

                                <!-- Tình trạng nội thất xe -->
                                <VBox spacing="4.0">
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 12.5px; -fx-font-weight: 600;" text="Tình Trạng Nội Thất &amp; Đồ Đạc Trong Xe" />
                                    <TextArea fx:id="txtTinhTrangNoiThat" prefRowCount="2" promptText="VD: Đồ đạc cá nhân khách đã lấy, màn hình android, ghế da..."
                                              style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-font-size: 13px;" wrapText="true" />
                                </VBox>

                                <!-- Ghi chú khác -->
                                <VBox spacing="4.0">
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 12.5px; -fx-font-weight: 600;" text="Ghi Chú Tiếp Nhận Khác" />
                                    <TextField fx:id="txtGhiChu" promptText="Ghi chú thêm nếu có..."
                                               style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 7px 10px; -fx-font-size: 13.5px;" />
                                </VBox>
                            </VBox>
                        </VBox>
                    </ScrollPane>

                    <Separator />

                    <!-- Nút Tạo Tiếp Nhận Ở Đáy Form (Nút Cam) -->
                    <VBox spacing="8.0">
                        <Button fx:id="btnLuuPhieu" maxWidth="Infinity" onAction="#onLuuPhieuClick"
                                style="-fx-background-color: #f47b31; -fx-text-fill: #ffffff; -fx-font-weight: 800; -fx-font-size: 14.5px; -fx-padding: 11px 16px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(244,123,49,0.3), 8, 0, 0, 2);"
                                text="➕ Tạo Tiếp Nhận" />
                    </VBox>

                </VBox>

            </HBox>

        </VBox>

    </HBox>

</VBox>

