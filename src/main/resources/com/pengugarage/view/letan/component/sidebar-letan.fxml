<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ================================================================= -->
<!-- COMPONENT SIDEBAR DÀNH CHO TIẾP NHẬN & BÁN HÀNG                   -->
<!-- (sidebar-letan.fxml)                                              -->
<!-- Bố cục thanh dọc bên trái có thể ĐÓNG / MỞ (Toggle Collapsible)   -->
<!-- Tone màu: Light Modern UI, Active Brand Navy #173B61              -->
<!-- ================================================================= -->

<VBox fx:id="rootSidebar" minWidth="60.0" prefWidth="230.0"
      style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 1px 0 0;"
      stylesheets="@../../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.component.SidebarLeTanController">

    <!-- 1. Header Sidebar: Tên phân mục đang xem + Nút Toggle Đóng/Mở (< / >) -->
    <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="6.0"
          style="-fx-padding: 10px 14px; -fx-border-color: #f1f5f9; -fx-border-width: 0 0 1px 0; -fx-background-color: #ffffff;">
        <Label fx:id="lblTenHangMuc"
               style="-fx-text-fill: #102A46; -fx-font-size: 11.5px; -fx-font-weight: 900; -fx-letter-spacing: 0.6px;"
               text="TIẾP NHẬN &amp; BÁN HÀNG" HBox.hgrow="ALWAYS" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnToggleSidebar" onAction="#onToggleSidebarClick"
                style="-fx-background-color: #f4f7fa; -fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 12px; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-cursor: hand; -fx-padding: 3px 8px;"
                text="&lt;" />
    </HBox>

    <!-- 2. Danh sách các nhóm chức năng -->
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
        <VBox fx:id="boxChucNang" spacing="4.0" style="-fx-padding: 10px 10px;">
            
            <!-- Dashboard -->
            <Button fx:id="btnDashboard" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDashboardClick"
                    styleClass="sidebar-nav-btn" text="📊 Dashboard" />

            <!-- Nhóm 1: Tiếp nhận -->
            <Label fx:id="lblSectionTiepNhan" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 12px 6px 4px 6px;" text="TIẾP NHẬN" />
            <Button fx:id="btnTiepNhanXe" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTiepNhanXeClick"
                    styleClass="sidebar-nav-btn" text="🚗 Tiếp nhận xe (Check-in)" />
            <Button fx:id="btnHangDoiXe" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onHangDoiXeClick"
                    styleClass="sidebar-nav-btn" text="⏳ Hàng đợi xe tại xưởng" />
            <Button fx:id="btnHoSoKhachHang" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onHoSoKhachHangClick"
                    styleClass="sidebar-nav-btn" text="👥 Hồ sơ khách hàng" />

            <!-- Nhóm 2: Bán hàng & Phụ tùng -->
            <Label fx:id="lblSectionBanHang" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 12px 6px 4px 6px;" text="BÁN HÀNG &amp; PHỤ TÙNG" />
            <Button fx:id="btnTaoDonBanHang" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTaoDonBanHangClick"
                    styleClass="sidebar-nav-btn" text="🛒 Tạo đơn bán hàng" />
            <Button fx:id="btnTraCuuGia" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTraCuuGiaClick"
                    styleClass="sidebar-nav-btn" text="🔍 Tra cứu sản phẩm" />

            <!-- Nhóm 3: Quản lý hóa đơn -->
            <Label fx:id="lblSectionHoaDon" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 12px 6px 4px 6px;" text="QUẢN LÝ HÓA ĐƠN" />
            <Button fx:id="btnLapHoaDon" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onLapHoaDonClick"
                    styleClass="sidebar-nav-btn" text="📄 Lập hóa đơn thanh toán" />
            <Button fx:id="btnDanhSachHoaDon" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDanhSachHoaDonClick"
                    styleClass="sidebar-nav-btn" text="📑 Danh sách hóa đơn" />


        </VBox>
    </ScrollPane>

    <!-- 3. Footer Sidebar: Hướng dẫn sử dụng (Dấu chấm than ❗) -->
    <VBox alignment="CENTER" style="-fx-padding: 8px 10px; -fx-border-color: #f1f5f9; -fx-border-width: 1px 0 0 0; -fx-background-color: #ffffff;">
        <Button fx:id="btnHuongDanSuDung" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onHuongDanSuDungClick"
                styleClass="sidebar-nav-btn" text="❗ Hướng dẫn sử dụng" />
    </VBox>

</VBox>
