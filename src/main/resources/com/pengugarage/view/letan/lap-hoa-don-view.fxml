<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- MÀN HÌNH LẬP HÓA ĐƠN & THU NGÂN                                      -->
<!-- (lap-hoa-don-view.fxml)                                              -->
<!-- Quản lý các hóa đơn in tạm chờ thanh toán (CHUA_THANH_TOAN)          -->
<!-- ===================================================================== -->

<VBox prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.LapHoaDonController">

    <!-- 1. Thanh Header Lễ Tân bên trên -->
    <fx:include source="component/header-letan.fxml" />

    <!-- 2. Thân Trang: Sidebar đóng mở bên trái + Vùng nội dung chính -->
    <HBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

        <!-- Sidebar Lễ Tân bên trái -->
        <fx:include source="component/sidebar-letan.fxml" />

        <!-- Vùng Nội Dung Làm Việc Chính (Chia 2 Cột Master - Detail) -->
        <VBox spacing="14.0" style="-fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
            </padding>

            <!-- Top Title Bar & Badges Trạng Thái -->
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #102A46; -fx-font-size: 22px; -fx-font-weight: 900;"
                           text="Lập Hóa Đơn &amp; Thu Ngân Thanh Toán" />
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;"
                           text="Quản lý danh sách các hóa đơn in tạm chờ thanh toán (CHƯA THANH TOÁN) - Kiểm tra, thu tiền và hoàn tất hóa đơn" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Badge số đơn chờ -->
                <Label fx:id="lblSoDonChoTT"
                       style="-fx-background-color: #fef3c7; -fx-text-fill: #b45309; -fx-padding: 6px 14px; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 12.5px;"
                       text="⏳ 0 đơn chờ thanh toán" />

                <!-- Badge tổng tiền chờ thu -->
                <Label fx:id="lblTongTienChoThu"
                       style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-padding: 6px 14px; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 12.5px;"
                       text="💰 Tổng chờ thu: 0 đ" />
            </HBox>

            <!-- Main Split Content: Cột Trái (Danh Sách Đơn Chờ) + Cột Phải (Quầy Thu Ngân Chi Tiết) -->
            <HBox spacing="16.0" VBox.vgrow="ALWAYS">

                <!-- =============================================================== -->
                <!-- CỘT TRÁI: DANH SÁCH CÁC HÓA ĐƠN IN TẠM (CHƯA THANH TOÁN)        -->
                <!-- =============================================================== -->
                <VBox prefWidth="540.0" spacing="10.0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-padding: 14px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;">

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label style="-fx-text-fill: #102a46; -fx-font-size: 14px; -fx-font-weight: 800;"
                               text="Danh Sách Hóa Đơn Chờ Thu Tiền" />
                    </HBox>

                    <!-- Thanh tìm kiếm & lọc đơn chờ -->
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <TextField fx:id="txtTimKiemDonCho"
                                   promptText="🔍 Mã HĐ, Tên KH, SĐT..."
                                   style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-padding: 7px 12px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-font-size: 12.5px;"
                                   HBox.hgrow="ALWAYS" />

                        <ComboBox fx:id="cboNguonDon" prefWidth="150.0" promptText="Nguồn đơn"
                                  styleClass="light-combo-box" />

                        <Button fx:id="btnLamMoiDanhSach" graphicTextGap="0.0" onAction="#onLamMoiDanhSachClick"
                                style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-text-fill: #334155; -fx-padding: 7px 14px; -fx-background-radius: 8px; -fx-cursor: hand;"
                                text="🔄" />
                    </HBox>

                    <!-- Bảng các hóa đơn CHUA_THANH_TOAN -->
                    <TableView fx:id="tblDonChoThanhToan" VBox.vgrow="ALWAYS" styleClass="garage-table">
                        <columns>
                            <TableColumn fx:id="colChoStt" prefWidth="40.0" text="#" />
                            <TableColumn fx:id="colChoMaHD" prefWidth="105.0" text="Mã HĐ" />
                            <TableColumn fx:id="colChoLoai" prefWidth="90.0" text="Nguồn" />
                            <TableColumn fx:id="colChoKhachHang" prefWidth="130.0" text="Khách Hàng" />
                            <TableColumn fx:id="colChoGioLap" prefWidth="105.0" text="Giờ In Tạm" />
                            <TableColumn fx:id="colChoTongTien" prefWidth="110.0" text="Cần Thu" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- =============================================================== -->
                <!-- CỘT PHẢI: CHI TIẾT HÓA ĐƠN & KHUNG THU TIỀN XÁC NHẬN             -->
                <!-- =============================================================== -->
                <VBox prefWidth="540.0" spacing="12.0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;">

                    <!-- Tiêu đề chi tiết & Trạng thái -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0"
                          style="-fx-padding: 0 0 8px 0; -fx-border-color: #f1f5f9; -fx-border-width: 0 0 1px 0;">
                        <Label fx:id="lblMaHoaDonHienTai"
                               style="-fx-text-fill: #102a46; -fx-font-size: 16px; -fx-font-weight: 900;"
                               text="HÓA ĐƠN: (Chưa chọn)" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblBadgeTrangThai"
                               style="-fx-background-color: #fef3c7; -fx-text-fill: #b45309; -fx-padding: 4px 10px; -fx-background-radius: 10px; -fx-font-weight: bold; -fx-font-size: 11.5px;"
                               text="● CHƯA THANH TOÁN" />
                    </HBox>

                    <!-- Khối tóm tắt thông tin khách hàng & xe -->
                    <VBox spacing="6.0" style="-fx-background-color: #f8fafc; -fx-padding: 10px 12px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                        <HBox spacing="16.0">
                            <HBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Khách hàng:" />
                                <Label fx:id="lblTenKhach" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 12.5px;" text="-" />
                            </HBox>
                            <HBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Số ĐT:" />
                                <Label fx:id="lblSdtKhach" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 12.5px;" text="-" />
                            </HBox>
                        </HBox>
                        <HBox spacing="16.0">
                            <HBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Biển số xe:" />
                                <Label fx:id="lblBienSo" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 12.5px;" text="-" />
                            </HBox>
                            <HBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Nhân viên lập:" />
                                <Label fx:id="lblNhanVienLap" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 12.5px;" text="-" />
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- Bảng các mục trong hóa đơn (Sản phẩm / Dịch vụ) -->
                    <TableView fx:id="tblChiTietThuNgan" prefHeight="160.0" VBox.vgrow="ALWAYS" styleClass="garage-table">
                        <columns>
                            <TableColumn fx:id="colMucStt" prefWidth="35.0" text="#" />
                            <TableColumn fx:id="colMucTen" prefWidth="180.0" text="Mặt Hàng / Dịch Vụ" />
                            <TableColumn fx:id="colMucSL" prefWidth="55.0" text="SL" />
                            <TableColumn fx:id="colMucDonGia" prefWidth="95.0" text="Đơn Giá" />
                            <TableColumn fx:id="colMucThanhTien" prefWidth="105.0" text="Thành Tiền" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <!-- Khối Tổng Hợp Tài Chính & Tính Tiền -->
                    <VBox spacing="6.0" style="-fx-background-color: #f8fafc; -fx-padding: 10px 14px; -fx-background-radius: 8px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px;">
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;" text="Tổng tiền hàng/dịch vụ:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTongTienHang" style="-fx-text-fill: #1e293b; -fx-font-weight: 600; -fx-font-size: 12.5px;" text="0 đ" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;" text="Giảm giá / Voucher:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTienGiamGia" style="-fx-text-fill: #dc2626; -fx-font-weight: 600; -fx-font-size: 12.5px;" text="- 0 đ" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;" text="Thuế VAT (10%):" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTienThue" style="-fx-text-fill: #1e293b; -fx-font-weight: 600; -fx-font-size: 12.5px;" text="0 đ" />
                        </HBox>

                        <Separator style="-fx-padding: 2px 0;" />

                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #102a46; -fx-font-size: 15px; -fx-font-weight: 900;" text="TỔNG TIỀN PHẢI THU:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTongCanThu" style="-fx-text-fill: #f47b31; -fx-font-size: 18px; -fx-font-weight: 900;" text="0 đ" />
                        </HBox>
                    </VBox>

                    <!-- Khối Lựa Chọn Phương Thức Thanh Toán -->
                    <VBox spacing="8.0">
                        <Label style="-fx-text-fill: #102a46; -fx-font-size: 12.5px; -fx-font-weight: 800;" text="Phương thức thanh toán:" />
                        <HBox spacing="20.0">
                            <RadioButton fx:id="radTienMat" selected="true" text="💵 Tiền mặt">
                                <toggleGroup>
                                    <ToggleGroup fx:id="grpPhuongThucTT" />
                                </toggleGroup>
                            </RadioButton>
                            <RadioButton fx:id="radChuyenKhoan" text="📲 Chuyển khoản QR" toggleGroup="$grpPhuongThucTT" />
                        </HBox>

                        <!-- Nhập tiền khách đưa & Tính tiền thừa trả khách -->
                        <HBox fx:id="boxTienMat" alignment="CENTER_LEFT" spacing="12.0">
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 11.5px;" text="Tiền khách đưa:" />
                                <TextField fx:id="txtTienKhachDua" promptText="0 đ"
                                           style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 10px; -fx-font-weight: bold; -fx-font-size: 13px;" />
                            </VBox>

                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 11.5px;" text="Tiền thừa trả khách:" />
                                <Label fx:id="lblTienThua"
                                       style="-fx-background-color: #f1f5f9; -fx-text-fill: #059669; -fx-padding: 6px 10px; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-font-weight: 900; -fx-font-size: 13px;"
                                       text="0 đ" />
                            </VBox>
                        </HBox>

                        <!-- Ghi chú thanh toán -->
                        <TextField fx:id="txtGhiChuThanhToan" promptText="Ghi chú thanh toán / Mã giao dịch chuyển khoản..."
                                   style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 10px; -fx-font-size: 12px;" />
                    </VBox>

                    <!-- Khối Nút Hành Động -->
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <!-- Nút Hủy Đơn In Tạm -->
                        <Button fx:id="btnHuyDon" onAction="#onHuyDonClick"
                                style="-fx-background-color: #fef2f2; -fx-text-fill: #dc2626; -fx-border-color: #fecaca; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-padding: 8px 14px; -fx-cursor: hand;"
                                text="❌ Hủy Đơn" />

                        <!-- Nút In Lại Phiếu Tạm Tính -->
                        <Button fx:id="btnInTamTinh" onAction="#onInTamTinhClick"
                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-padding: 8px 14px; -fx-cursor: hand;"
                                text="🖨️ In Phiếu Tạm" />

                        <!-- Nút Xác Nhận Thanh Toán & In Hóa Đơn Chính Thức -->
                        <Button fx:id="btnXacNhanThanhToan" onAction="#onXacNhanThanhToanClick"
                                style="-fx-background-color: #059669; -fx-text-fill: #ffffff; -fx-background-radius: 8px; -fx-font-weight: 900; -fx-font-size: 13px; -fx-padding: 9px 18px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(5,150,105,0.3), 8, 0, 0, 2);"
                                text="✔ XÁC NHẬN THANH TOÁN" />
                    </HBox>

                </VBox>

            </HBox>

        </VBox>
    </HBox>

</VBox>

