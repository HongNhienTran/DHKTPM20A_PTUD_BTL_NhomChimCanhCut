<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- DASHBOARD LỄ TÂN & THU NGÂN (dashboard-view.fxml)                     -->
<!-- Tone màu: Light Modern UI, Header đề mục lớn, Sidebar đóng mở,        -->
<!-- Nền vùng làm việc Trắng #FFFFFF / #F8FAFC sáng sủa, dễ quan sát      -->
<!-- ===================================================================== -->

<VBox fx:id="rootView" prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.DashboardLeTanController">

    <!-- 1. Thanh Header Lễ Tân bên trên (Các đề mục lớn) -->
    <fx:include source="component/header-letan.fxml" />

    <!-- 2. Thân Trang: Sidebar đóng mở bên trái + Vùng nội dung chính -->
    <HBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

        <!-- Sidebar bên trái (Đóng mở linh hoạt) -->
        <fx:include source="component/sidebar-letan.fxml" />

        <!-- Vùng Nội Dung Làm Việc Chính (Nền Trắng #f8fafc) -->
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

            <!-- Main Dashboard Scrollable Area -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                <VBox spacing="20.0" style="-fx-padding: 24px 28px 36px 28px;">


                    <!-- ================= 4 KPI CARDS (NỀN TRẮNG #FFFFFF) ================= -->
                    <HBox spacing="16.0">
                        <!-- Card 1: Lượt tiếp nhận -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 18px 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Lượt tiếp nhận hôm nay" style="-fx-text-fill: #64748b; -fx-font-size: 13.5px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiTiepNhanHomNayLabel" text="18 lượt" style="-fx-text-fill: #059669; -fx-font-size: 26px; -fx-font-weight: 900;" />
                            <Label text="▲ +12,5% so với hôm qua" style="-fx-text-fill: #10b981; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Card 2: Chờ phân công -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 18px 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Xe mới chờ phân công KTV" style="-fx-text-fill: #64748b; -fx-font-size: 13.5px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiChoPhanCongLabel" text="3 xe" style="-fx-text-fill: #f47b31; -fx-font-size: 26px; -fx-font-weight: 900;" />
                            <Label text="Cần chỉ định KTV kiểm tra xe" style="-fx-text-fill: #ea580c; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Card 3: Chờ giao xe & thanh toán -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 18px 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Xe đã xong chờ giao khách" style="-fx-text-fill: #64748b; -fx-font-size: 13.5px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiChoThanhToanLabel" text="6 xe" style="-fx-text-fill: #173b61; -fx-font-size: 26px; -fx-font-weight: 900;" />
                            <Label text="Sẵn sàng thu tiền &amp; giao xe" style="-fx-text-fill: #0284c7; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Card 4: Tổng thu trong ngày -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 18px 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Tổng thu ngân trong ngày" style="-fx-text-fill: #64748b; -fx-font-size: 13.5px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiDoanhThuNgayLabel" text="38,5 tr đ" style="-fx-text-fill: #102A46; -fx-font-size: 26px; -fx-font-weight: 900;" />
                            <Label text="Tiền mặt: 12 tr • CK: 26,5 tr" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        </VBox>
                    </HBox>

                    <!-- ================= 2 CỘT CHỨC NĂNG CHÍNH (NỀN TRẮNG #FFFFFF) ================= -->
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        
                        <!-- Cột Trái: Hàng Đợi Phương Tiện Tại Gara (65% chiều rộng) -->
                        <VBox HBox.hgrow="ALWAYS" spacing="16.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="2.0">
                                    <Label text="Hàng Đợi Phương Tiện Tại Gara (Live Queue)"
                                           style="-fx-text-fill: #102A46; -fx-font-size: 17.5px; -fx-font-weight: 800;" />
                                    <Label text="Cập nhật tiến độ xử lý và bàn giao phương tiện theo thời gian thực"
                                           style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="● 4 xe đang thao tác" style="-fx-text-fill: #059669; -fx-font-size: 13px; -fx-font-weight: bold;" />
                            </HBox>

                            <VBox spacing="10.0">
                                <!-- Hàng 1: Đang sửa chữa -->
                                <HBox alignment="CENTER_LEFT" spacing="14.0"
                                      style="-fx-background-color: #f8fafc; -fx-padding: 14px 18px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                    <VBox spacing="2.0" prefWidth="130.0">
                                        <Label text="51F-123.45" style="-fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 15.5px;" />
                                        <Label text="Toyota Vios E" style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="Bảo dưỡng 40.000 km &amp; Thay nhớt máy" style="-fx-text-fill: #1e293b; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                        <Label text="KTV: Nguyễn Văn Hùng • Cầu nâng 2 • Bắt đầu: 08:30" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                                    </VBox>
                                    <Label text="ĐANG SỬA CHỮA"
                                           style="-fx-background-color: #fff4d8; -fx-text-fill: #b45309; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-size: 12px; -fx-font-weight: 800; -fx-border-color: #fde68a; -fx-border-radius: 6px;" />
                                </HBox>

                                <!-- Hàng 2: Chờ thanh toán & giao xe -->
                                <HBox alignment="CENTER_LEFT" spacing="14.0"
                                      style="-fx-background-color: #f8fafc; -fx-padding: 14px 18px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                    <VBox spacing="2.0" prefWidth="130.0">
                                        <Label text="30H-998.12" style="-fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 15.5px;" />
                                        <Label text="Mazda CX-5" style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="Sơn dặm cản trước &amp; Đánh bóng thân xe" style="-fx-text-fill: #1e293b; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                        <Label text="KTV: Lê Hoàng Long • Tổng hóa đơn: 4.850.000 đ" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                                    </VBox>
                                    <Label text="CHỜ THANH TOÁN"
                                           style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-size: 12px; -fx-font-weight: 800; -fx-border-color: #bfd7ee; -fx-border-radius: 6px;" />
                                </HBox>

                                <!-- Hàng 3: Xe mới tiếp nhận -->
                                <HBox alignment="CENTER_LEFT" spacing="14.0"
                                      style="-fx-background-color: #f8fafc; -fx-padding: 14px 18px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                    <VBox spacing="2.0" prefWidth="130.0">
                                        <Label text="60A-776.54" style="-fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 15.5px;" />
                                        <Label text="Kia Seltos 1.4" style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="Tiếng kêu lạ ở giảm xóc trước khi qua gờ giảm tốc" style="-fx-text-fill: #1e293b; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                        <Label text="Tiếp nhận: 09:15 • Khách: Trần Văn An (0903.112.233)" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                                    </VBox>
                                    <Label text="CHỜ PHÂN CÔNG"
                                           style="-fx-background-color: #fee2d5; -fx-text-fill: #c2410c; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-size: 12px; -fx-font-weight: 800; -fx-border-color: #fed7aa; -fx-border-radius: 6px;" />
                                </HBox>

                                <!-- Hàng 4: Hoàn thành & đã giao xe -->
                                <HBox alignment="CENTER_LEFT" spacing="14.0"
                                      style="-fx-background-color: #f8fafc; -fx-padding: 14px 18px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                    <VBox spacing="2.0" prefWidth="130.0">
                                        <Label text="51K-345.67" style="-fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 15.5px;" />
                                        <Label text="Hyundai Tucson" style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="Cân chỉnh thước lái &amp; Đảo 4 lốp xe" style="-fx-text-fill: #1e293b; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                        <Label text="Đã thu: 950.000 đ (Chuyển khoản) • Giao xe: 09:40" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                                    </VBox>
                                    <Label text="ĐÃ BÀN GIAO"
                                           style="-fx-background-color: #e7f7f0; -fx-text-fill: #0d6832; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-size: 12px; -fx-font-weight: 800; -fx-border-color: #a3e3c5; -fx-border-radius: 6px;" />
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Cột Phải: Thao Tác Nhanh & Lịch Hẹn Sắp Đến (35% chiều rộng) -->
                        <VBox prefWidth="380.0" spacing="16.0">
                            
                            <!-- Thao tác nhanh -->
                            <VBox spacing="12.0"
                                  style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                                <Label text="Thao Tác Nhanh Nghiệp Vụ" style="-fx-text-fill: #102A46; -fx-font-size: 17.5px; -fx-font-weight: 800;" />
                                
                                <Button fx:id="btnTiepNhanXeNhanh" onAction="#onTiepNhanXeClick" text="🚗 Tiếp Nhận Xe" maxWidth="Infinity"
                                        styleClass="action-button" />

                                <Button fx:id="btnHangDoiXeNhanh" onAction="#onHangDoiXeClick" text="⏳ Hàng Đợi Xe Tại Xưởng" maxWidth="Infinity"
                                        styleClass="primary-button" />

                                <Button fx:id="btnTaoDonBanHangNhanh" onAction="#onTaoDonBanHangClick" text="🛒 Tạo Đơn Bán Hàng Phụ Tùng" maxWidth="Infinity"
                                        styleClass="secondary-button" />

                                <Button fx:id="btnLapHoaDonNhanh" onAction="#onLapHoaDonClick" text="📄 Quản Lý &amp; Lập Hóa Đơn" maxWidth="Infinity"
                                        styleClass="secondary-button" />
                            </VBox>

                            <!-- Tiến độ hàng đợi xe tại xưởng hôm nay (Click để chuyển sang tab Hàng đợi xe) -->
                            <VBox fx:id="cardHangDoiXe" onMouseClicked="#onHangDoiXeClick" spacing="12.0" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1); -fx-cursor: hand;">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="1.0">
                                        <Label text="Hàng Đợi Xe Tại Xưởng" style="-fx-text-fill: #102A46; -fx-font-size: 16.5px; -fx-font-weight: 800;" />
                                        <Label text="Nhấn để mở Kanban Board ➔" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblTongXeHangDoi" text="● 0 xe tại xưởng"
                                           style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-padding: 4px 10px; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-border-color: #bfd7ee; -fx-border-radius: 12px;" />
                                </HBox>

                                <VBox spacing="8.0">
                                    <!-- 1. Chờ kiểm tra -->
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" onMouseClicked="#onHangDoiXeClick"
                                          style="-fx-padding: 9px 12px; -fx-background-color: #eff6ff; -fx-background-radius: 6px; -fx-border-color: #bfdbfe; -fx-border-radius: 6px; -fx-cursor: hand;">
                                        <Label text="⏳" style="-fx-font-size: 15px;" />
                                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                            <Label text="1. Chờ kiểm tra" style="-fx-text-fill: #1d4ed8; -fx-font-weight: bold; -fx-font-size: 13.5px;" />
                                            <Label text="Xe mới tiếp nhận, chờ KTV kiểm tra ban đầu" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                                        </VBox>
                                        <Label fx:id="lblSoLuongChoKiemTra" text="0 xe"
                                               style="-fx-background-color: #dbeafe; -fx-text-fill: #1d4ed8; -fx-font-size: 13px; -fx-font-weight: 800; -fx-padding: 3px 10px; -fx-background-radius: 10px;" />
                                    </HBox>

                                    <!-- 2. Kiểm tra & Báo giá -->
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" onMouseClicked="#onHangDoiXeClick"
                                          style="-fx-padding: 9px 12px; -fx-background-color: #fff7ed; -fx-background-radius: 6px; -fx-border-color: #fed7aa; -fx-border-radius: 6px; -fx-cursor: hand;">
                                        <Label text="🔍" style="-fx-font-size: 15px;" />
                                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                            <Label text="2. Kiểm tra &amp; Báo giá" style="-fx-text-fill: #ea580c; -fx-font-weight: bold; -fx-font-size: 13.5px;" />
                                            <Label text="Lập báo giá, gửi khách &amp; phân công thợ" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                                        </VBox>
                                        <Label fx:id="lblSoLuongKhamBaoGia" text="0 xe"
                                               style="-fx-background-color: #ffedd5; -fx-text-fill: #c2410c; -fx-font-size: 13px; -fx-font-weight: 800; -fx-padding: 3px 10px; -fx-background-radius: 10px;" />
                                    </HBox>

                                    <!-- 3. Đang sửa chữa (Orange tone) -->
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" onMouseClicked="#onHangDoiXeClick"
                                          style="-fx-padding: 9px 12px; -fx-background-color: #fff7ed; -fx-background-radius: 6px; -fx-border-color: #fed7aa; -fx-border-radius: 6px; -fx-cursor: hand;">
                                        <Label text="🔧" style="-fx-font-size: 15px;" />
                                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                            <Label text="3. Đang sửa chữa" style="-fx-text-fill: #ea580c; -fx-font-weight: bold; -fx-font-size: 13.5px;" />
                                            <Label text="Kỹ thuật viên đang tiến hành sửa chữa tại khoang" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                                        </VBox>
                                        <Label fx:id="lblSoLuongDangSuaChua" text="0 xe"
                                               style="-fx-background-color: #ffedd5; -fx-text-fill: #c2410c; -fx-font-size: 13px; -fx-font-weight: 800; -fx-padding: 3px 10px; -fx-background-radius: 10px;" />
                                    </HBox>

                                    <!-- 4. Chờ bàn giao -->
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" onMouseClicked="#onHangDoiXeClick"
                                          style="-fx-padding: 9px 12px; -fx-background-color: #ecfdf5; -fx-background-radius: 6px; -fx-border-color: #a7f3d0; -fx-border-radius: 6px; -fx-cursor: hand;">
                                        <Label text="✅" style="-fx-font-size: 15px;" />
                                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                            <Label text="4. Chờ bàn giao" style="-fx-text-fill: #059669; -fx-font-weight: bold; -fx-font-size: 13.5px;" />
                                            <Label text="Hoàn tất kỹ thuật, sẵn sàng xuất hóa đơn" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                                        </VBox>
                                        <Label fx:id="lblSoLuongChoBanGiao" text="0 xe"
                                               style="-fx-background-color: #d1fae5; -fx-text-fill: #059669; -fx-font-size: 13px; -fx-font-weight: 800; -fx-padding: 3px 10px; -fx-background-radius: 10px;" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </VBox>

                    </HBox>

                </VBox>
            </ScrollPane>

        </VBox>

    </HBox>

</VBox>
