<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- MÀN HÌNH QUẢN LÝ HỒ SƠ KHÁCH HÀNG (ho-so-khach-hang-view.fxml)         -->
<!-- Phục vụ cho Lễ tân, Thu ngân và Cố vấn dịch vụ                        -->
<!-- ===================================================================== -->

<VBox prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.HoSoKhachHangController">

    <!-- 1. Thanh Header Lễ Tân bên trên -->
    <fx:include source="component/header-letan.fxml" />

    <!-- 2. Thân Trang: Sidebar đóng mở bên trái + Vùng nội dung chính -->
    <HBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

        <!-- Sidebar Lễ Tân bên trái -->
        <fx:include source="component/sidebar-letan.fxml" />

        <!-- Vùng Nội Dung Làm Việc Chính -->
        <VBox spacing="14.0" style="-fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
            </padding>

            <!-- Top Title Bar & Nút Thao Tác -->
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #102A46; -fx-font-size: 22px; -fx-font-weight: 900;"
                           text="Hồ Sơ Khách Hàng" />
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;"
                           text="Quản lý thông tin định danh khách hàng, liên hệ và danh sách phương tiện sở hữu tại gara" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Badge tổng số khách hàng -->
                <Label fx:id="lblTongSoKhachHang"
                       style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-padding: 6px 14px; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 12.5px;"
                       text="👥 Tổng số: 0 khách hàng" />

                <!-- Nút Làm Mới -->
                <Button fx:id="btnLamMoi" onAction="#onLamMoiClick"
                        style="-fx-background-color: #102A46; -fx-text-fill: #ffffff; -fx-font-weight: 700; -fx-font-size: 12.5px; -fx-padding: 8px 14px; -fx-background-radius: 8px; -fx-cursor: hand;"
                        text="🔄 Làm Mới" />
            </HBox>

            <!-- Thanh Tìm Kiếm & Lọc Dữ Liệu -->
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #ffffff; -fx-padding: 10px 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;">
                <TextField fx:id="txtTimKiem"
                           promptText="🔍 Tìm kiếm theo Mã KH, Họ tên, Số điện thoại, Địa chỉ..."
                           style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-padding: 7px 14px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-font-size: 13px;"
                           HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="cboLocGioiTinh" prefWidth="160.0" promptText="Giới tính"
                          styleClass="light-combo-box" />

                <Button fx:id="btnTimKiem" onAction="#onTimKiemClick"
                        style="-fx-background-color: #173b61; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-padding: 7px 16px; -fx-background-radius: 8px; -fx-cursor: hand;"
                        text="Tìm kiếm" />

                <Button fx:id="btnXoaLoc" graphicTextGap="0.0" onAction="#onXoaLocClick"
                        style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-text-fill: #334155; -fx-padding: 7px 14px; -fx-background-radius: 8px; -fx-cursor: hand;"
                        text="🔄" />
            </HBox>

            <!-- Vùng Nội Dung Chính: Bố Cục 2 Cột (Bảng Danh Sách Khách Hàng + Chi Tiết & Xe Sở Hữu) -->
            <HBox spacing="16.0" VBox.vgrow="ALWAYS">

                <!-- =============================================================== -->
                <!-- CỘT TRÁI: BẢNG DANH SÁCH KHÁCH HÀNG                            -->
                <!-- =============================================================== -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-padding: 14px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: #102a46; -fx-font-size: 14px; -fx-font-weight: 800;"
                               text="Danh Sách Hồ Sơ Khách Hàng" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSoBanGhi" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: 600;"
                               text="Hiển thị: 0 khách hàng" />
                    </HBox>

                    <TableView fx:id="tblKhachHang" VBox.vgrow="ALWAYS" styleClass="garage-table">
                        <columns>
                            <TableColumn fx:id="colStt" prefWidth="45.0" text="STT" />
                            <TableColumn fx:id="colMaKH" prefWidth="100.0" text="Mã KH" />
                            <TableColumn fx:id="colHoTen" prefWidth="160.0" text="Họ Và Tên" />
                            <TableColumn fx:id="colSoDienThoai" prefWidth="120.0" text="Số Điện Thoại" />
                            <TableColumn fx:id="colGioiTinh" prefWidth="85.0" text="Giới Tính" />
                            <TableColumn fx:id="colDiaChi" prefWidth="200.0" text="Địa Chỉ" />
                            <TableColumn fx:id="colThaoTac" prefWidth="90.0" text="Thao Tác" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- =============================================================== -->
                <!-- CỘT PHẢI: CHI TIẾT HỒ SƠ & PHƯƠNG TIỆN SỞ HỮU                  -->
                <!-- =============================================================== -->
                <VBox prefWidth="480.0" spacing="12.0"
                      style="-fx-background-color: #ffffff; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;">

                    <!-- Tiêu đề chi tiết & Badge -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0"
                          style="-fx-padding: 0 0 8px 0; -fx-border-color: #f1f5f9; -fx-border-width: 0 0 1px 0;">
                        <Label fx:id="lblChiTietTieuDe"
                               style="-fx-text-fill: #102a46; -fx-font-size: 15px; -fx-font-weight: 900;"
                               text="Thông Tin Khách Hàng" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblBadgeMaKH"
                               style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-padding: 3px 10px; -fx-background-radius: 10px; -fx-font-weight: bold; -fx-font-size: 11.5px;"
                               text="Chưa chọn" />
                    </HBox>

                    <!-- Form nhập / chỉnh sửa thông tin khách hàng -->
                    <VBox spacing="8.0">
                        <!-- Hàng: Mã KH & Giới tính -->
                        <HBox spacing="10.0">
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 11.5px; -fx-font-weight: 600;" text="Mã khách hàng:" />
                                <TextField fx:id="txtFormMaKH" disable="true" promptText="Tự động tạo (KHxxxx)"
                                           style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 10px; -fx-font-size: 12.5px;" />
                            </VBox>

                            <VBox prefWidth="150.0" spacing="2.0">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 11.5px; -fx-font-weight: 600;" text="Giới tính:" />
                                <ComboBox fx:id="cboFormGioiTinh" maxWidth="Infinity" promptText="Chọn"
                                          styleClass="light-combo-box" />
                            </VBox>
                        </HBox>

                        <!-- Họ và tên -->
                        <VBox spacing="2.0">
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 11.5px; -fx-font-weight: 600;" text="Họ và tên (*):" />
                            <TextField fx:id="txtFormHoTen" promptText="Nhập đầy đủ họ và tên..."
                                       style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 10px; -fx-font-size: 12.5px;" />
                        </VBox>

                        <!-- Số điện thoại -->
                        <VBox spacing="2.0">
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 11.5px; -fx-font-weight: 600;" text="Số điện thoại (*):" />
                            <TextField fx:id="txtFormSoDienThoai" promptText="09xxxxxxxx..."
                                       style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 10px; -fx-font-size: 12.5px;" />
                        </VBox>

                        <!-- Địa chỉ -->
                        <VBox spacing="2.0">
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 11.5px; -fx-font-weight: 600;" text="Địa chỉ:" />
                            <TextField fx:id="txtFormDiaChi" promptText="Số nhà, đường, phường/xã, quận/huyện..."
                                       style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 10px; -fx-font-size: 12.5px;" />
                        </VBox>

                        <!-- Hàng nút thao tác Form -->
                        <HBox alignment="CENTER_RIGHT" spacing="8.0" style="-fx-padding: 6px 0 0 0;">
                            <Button fx:id="btnHuyForm" onAction="#onHuyFormClick"
                                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-weight: 600; -fx-font-size: 12px; -fx-padding: 6px 12px; -fx-cursor: hand;"
                                    text="Làm mới form" />

                            <Button fx:id="btnLuuForm" onAction="#onLuuFormClick"
                                    style="-fx-background-color: #059669; -fx-text-fill: #ffffff; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 6px 14px; -fx-cursor: hand;"
                                    text="💾 Lưu Thông Tin" />

                            <!-- Nút Thêm Mới Khách Hàng (Màu Cam Thương Hiệu #F47B31) -->
                            <Button fx:id="btnThemMoi" onAction="#onThemMoiClick"
                                    style="-fx-background-color: #f47b31; -fx-text-fill: #ffffff; -fx-font-weight: 800; -fx-font-size: 12px; -fx-padding: 6px 16px; -fx-background-radius: 6px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(244,123,49,0.25), 6, 0, 0, 1);"
                                    text="➕ Thêm Khách Hàng" />
                        </HBox>
                    </VBox>

                    <Separator style="-fx-padding: 4px 0;" />

                    <!-- =========================================================== -->
                    <!-- KHỐI PHƯƠNG TIỆN (XE Ô TÔ) CỦA KHÁCH HÀNG                    -->
                    <!-- =========================================================== -->
                    <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #102a46; -fx-font-size: 13px; -fx-font-weight: 800;"
                                   text="🚗 PHƯƠNG TIỆN SỞ HỮU" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnThemXe" onAction="#onThemXeClick"
                                    style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-font-size: 11.5px; -fx-padding: 4px 10px; -fx-cursor: hand;"
                                    text="➕ Thêm Xe" />
                        </HBox>

                        <TableView fx:id="tblXeKhachHang" prefHeight="150.0" VBox.vgrow="ALWAYS" styleClass="garage-table">
                            <columns>
                                <TableColumn fx:id="colXeStt" prefWidth="35.0" text="#" />
                                <TableColumn fx:id="colXeBienSo" prefWidth="110.0" text="Biển Số Xe" />
                                <TableColumn fx:id="colXeHangMau" prefWidth="140.0" text="Hãng &amp; Mẫu Xe" />
                                <TableColumn fx:id="colXeMauSac" prefWidth="80.0" text="Màu Sắc" />
                                <TableColumn fx:id="colXeNamSX" prefWidth="70.0" text="Năm SX" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <!-- Khối tóm tắt giao dịch gần nhất -->
                    <VBox spacing="4.0" style="-fx-background-color: #f8fafc; -fx-padding: 8px 12px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 11.5px;" text="Lần dịch vụ gần nhất:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblLanDichVuGanNhat" style="-fx-text-fill: #102a46; -fx-font-weight: bold; -fx-font-size: 11.5px;" text="Chưa có dữ liệu" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 11.5px;" text="Tổng chi tiêu tích lũy:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTongChiTieu" style="-fx-text-fill: #059669; -fx-font-weight: 800; -fx-font-size: 12px;" text="0 đ" />
                        </HBox>
                    </VBox>

                </VBox>

            </HBox>

        </VBox>
    </HBox>

</VBox>

