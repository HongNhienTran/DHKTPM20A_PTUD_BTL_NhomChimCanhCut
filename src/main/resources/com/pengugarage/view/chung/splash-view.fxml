<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: radial-gradient(center 50% 45%, radius 65%, #102438 0%, #060d16 100%);" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pengugarage.controller.ManHinhChaoController">

    <!-- Khối trung tâm màn hình chào (Splash Screen) -->
    <VBox alignment="CENTER" maxWidth="560.0" spacing="28.0">
        
        <!-- Khung Logo phát sáng thương hiệu -->
        <StackPane alignment="CENTER" maxHeight="220.0" maxWidth="220.0" style="-fx-background-color: rgba(23, 59, 97, 0.4); -fx-background-radius: 36px; -fx-padding: 18px; -fx-border-color: rgba(244, 123, 49, 0.4); -fx-border-radius: 36px; -fx-border-width: 1.5px; -fx-effect: dropshadow(three-pass-box, rgba(244, 123, 49, 0.35), 36, 0, 0, 0);">
            <ImageView fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../images/logo_pengu-garage.png" />
                </image>
            </ImageView>
        </StackPane>

        <!-- Tiêu đề & Slogan thương hiệu -->
        <VBox alignment="CENTER" spacing="10.0">
            <Label style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #ffffff; -fx-letter-spacing: 2px; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.6), 8, 0, 0, 2);" text="PENGU GARAGE" />
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #f47b31; -fx-letter-spacing: 3px;" text="SERVICE ERP • YOUR CAR, OUR CARE" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: #8c9eb2;" text="Hệ Thống Quản Lý Dịch Vụ Gara Ô Tô &amp; Xe Máy Chuyên Nghiệp" />
        </VBox>

        <!-- Thanh tiến trình khởi động (Loading Progress) -->
        <VBox maxWidth="460.0" prefWidth="460.0" spacing="10.0" style="-fx-padding: 8px 0 0 0;">
            <ProgressBar fx:id="progressBar" prefHeight="8.0" prefWidth="460.0" progress="0.0" style="-fx-accent: #f47b31; -fx-control-inner-background: #0b1624;" />
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="statusLabel" style="-fx-text-fill: #9ab0c7; -fx-font-size: 12px; -fx-font-weight: 500;" text="Đang khởi tạo ứng dụng..." />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="percentLabel" style="-fx-text-fill: #f47b31; -fx-font-size: 12px; -fx-font-weight: bold;" text="0%" />
            </HBox>
        </VBox>

        <!-- Footer phiên bản -->
        <HBox alignment="CENTER" spacing="8.0" style="-fx-padding: 16px 0 0 0;">
            <Label style="-fx-text-fill: #10b981; -fx-font-size: 9px;" text="●" />
        </HBox>

    </VBox>

</StackPane>
