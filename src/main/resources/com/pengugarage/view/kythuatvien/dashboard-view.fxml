<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- DASHBOARD KỸ THUẬT VIÊN (dashboard-view.fxml)                         -->
<!-- Tone màu: Light Modern UI, Header đề mục lớn, Sidebar đóng mở,        -->
<!-- Nền vùng làm việc Trắng #FFFFFF / #F8FAFC sáng sủa, dễ quan sát      -->
<!-- ===================================================================== -->

<VBox prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.DashboardKyThuatVienController">

    <!-- 1. Thanh Header Kỹ Thuật Viên bên trên (Các đề mục lớn) -->
    <fx:include source="component/header-kythuatvien.fxml" />

    <!-- 2. Thân Trang: Sidebar đóng mở bên trái + Vùng nội dung chính -->
    <HBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

        <!-- Sidebar bên trái (Đóng mở linh hoạt) -->
        <fx:include source="component/sidebar-kythuatvien.fxml" />

        <!-- Vùng Nội Dung Làm Việc Chính (Nền Trắng #f8fafc) -->
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

            <!-- Main Dashboard Scrollable Area -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                <VBox spacing="20.0" style="-fx-padding: 24px 28px 36px 28px;">

                    <!-- Title Section -->
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4.0">
                            <Label text="Bàn Làm Việc Kỹ Thuật Viên"
                                   style="-fx-text-fill: #102A46; -fx-font-size: 24px; -fx-font-weight: 900;" />
                            <Label text="Quản lý tiến độ phân công sửa chữa, trạng thái từng xe tại cầu nâng và xuất vật tư phụ tùng"
                                   style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <!-- Badge trạng thái cầu nâng -->
                        <Label text="● Cầu nâng đang hoạt động: 4/5"
                               style="-fx-background-color: #e7f7f0; -fx-text-fill: #0d6832; -fx-font-weight: 800; -fx-font-size: 12px; -fx-padding: 6px 14px; -fx-background-radius: 20px; -fx-border-color: #a3e3c5; -fx-border-radius: 20px;" />
                    </HBox>

                    <!-- ================= 4 KPI CARDS (NỀN TRẮNG #FFFFFF) ================= -->
                    <HBox spacing="16.0">
                        <!-- Card 1: Ca đang sửa -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 18px 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Ca sửa chữa đang phụ trách" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiDangSuaLabel" text="3 ca" style="-fx-text-fill: #f47b31; -fx-font-size: 24px; -fx-font-weight: 900;" />
                            <Label text="2 đang trên cầu • 1 chờ phụ tùng" style="-fx-text-fill: #ea580c; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Card 2: Chờ tiếp nhận -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 18px 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Xe chờ bắt đầu sửa chữa" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiChoTiepNhanLabel" text="4 xe" style="-fx-text-fill: #173b61; -fx-font-size: 24px; -fx-font-weight: 900;" />
                            <Label text="Khách đã duyệt báo giá hoàn tất" style="-fx-text-fill: #0284c7; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Card 3: Hoàn thành trong ngày -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 18px 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Xe hoàn thành hôm nay" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiHoanThanhLabel" text="5 xe" style="-fx-text-fill: #059669; -fx-font-size: 24px; -fx-font-weight: 900;" />
                            <Label text="Đã kiểm định an toàn và rửa xe" style="-fx-text-fill: #10b981; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Card 4: Đề xuất phụ tùng chờ duyệt -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 18px 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Yêu cầu phụ tùng chờ duyệt" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiVatTuChoDuyetLabel" text="2 yêu cầu" style="-fx-text-fill: #d97706; -fx-font-size: 24px; -fx-font-weight: 900;" />
                            <Label text="Cần Quản lý duyệt xuất kho" style="-fx-text-fill: #b45309; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>
                    </HBox>

                    <!-- ================= 2 CỘT CHỨC NĂNG CHÍNH (NỀN TRẮNG #FFFFFF) ================= -->
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        
                        <!-- Cột Trái: Danh Sách Phiếu Phân Công Trong Ca (65% chiều rộng) -->
                        <VBox HBox.hgrow="ALWAYS" spacing="16.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="2.0">
                                    <Label text="Danh Sách Phiếu Phân Công Trong Ca"
                                           style="-fx-text-fill: #102A46; -fx-font-size: 16px; -fx-font-weight: 800;" />
                                    <Label text="Tiến độ thực tế các xe đang được phân bổ cho kỹ thuật viên"
                                           style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="● 4 xe đang phụ trách" style="-fx-text-fill: #173b61; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            </HBox>

                            <VBox spacing="10.0">
                                <!-- Ca 1: Đang sửa -->
                                <HBox alignment="CENTER_LEFT" spacing="14.0"
                                      style="-fx-background-color: #f8fafc; -fx-padding: 14px 18px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                    <VBox spacing="2.0" prefWidth="120.0">
                                        <Label text="51F-123.45" style="-fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 14px;" />
                                        <Label text="Toyota Vios E" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="Bảo dưỡng định kỳ cấp lớn 40.000 km &amp; Thay nhớt động cơ" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                        <Label text="Cầu nâng số 2 • Dự kiến xong: 10:30" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                    </VBox>
                                    <Label text="ĐANG SỬA CHỮA"
                                           style="-fx-background-color: #fee2d5; -fx-text-fill: #c2410c; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-size: 11px; -fx-font-weight: 800; -fx-border-color: #fed7aa; -fx-border-radius: 6px;" />
                                </HBox>

                                <!-- Ca 2: Đang sửa -->
                                <HBox alignment="CENTER_LEFT" spacing="14.0"
                                      style="-fx-background-color: #f8fafc; -fx-padding: 14px 18px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                    <VBox spacing="2.0" prefWidth="120.0">
                                        <Label text="51G-678.90" style="-fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 14px;" />
                                        <Label text="Honda City RS" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="Thay bộ má phanh trước &amp; Láng đĩa phanh" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                        <Label text="Cầu nâng số 1 • Dự kiến xong: 11:15" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                    </VBox>
                                    <Label text="ĐANG SỬA CHỮA"
                                           style="-fx-background-color: #fee2d5; -fx-text-fill: #c2410c; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-size: 11px; -fx-font-weight: 800; -fx-border-color: #fed7aa; -fx-border-radius: 6px;" />
                                </HBox>

                                <!-- Ca 3: Chờ phụ tùng -->
                                <HBox alignment="CENTER_LEFT" spacing="14.0"
                                      style="-fx-background-color: #f8fafc; -fx-padding: 14px 18px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                    <VBox spacing="2.0" prefWidth="120.0">
                                        <Label text="60A-456.78" style="-fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 14px;" />
                                        <Label text="Hyundai Accent" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="Kiểm tra hệ thống lạnh &amp; Thay lốc điều hòa" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                        <Label text="Khu vực kiểm định điện • Đã gửi yêu cầu vật tư" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                    </VBox>
                                    <Label text="CHỜ PHỤ TÙNG"
                                           style="-fx-background-color: #fef3c7; -fx-text-fill: #b45309; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-size: 11px; -fx-font-weight: 800; -fx-border-color: #fde68a; -fx-border-radius: 6px;" />
                                </HBox>

                                <!-- Ca 4: Chờ tiếp nhận -->
                                <HBox alignment="CENTER_LEFT" spacing="14.0"
                                      style="-fx-background-color: #f8fafc; -fx-padding: 14px 18px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                    <VBox spacing="2.0" prefWidth="120.0">
                                        <Label text="61K-890.12" style="-fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 14px;" />
                                        <Label text="VinFast VF8" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label text="Kiểm tra góc đặt bánh xe &amp; Cân chỉnh độ chụm" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                        <Label text="Bãi đỗ chờ số 3 • Sẵn sàng tiếp nhận" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                    </VBox>
                                    <Label text="CHỜ TIẾP NHẬN"
                                           style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-size: 11px; -fx-font-weight: 800; -fx-border-color: #bfd7ee; -fx-border-radius: 6px;" />
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Cột Phải: Thao Tác Nhanh & Tình Trạng Cầu Nâng (35% chiều rộng) -->
                        <VBox prefWidth="380.0" spacing="16.0">
                            
                            <!-- Thao tác nhanh kỹ thuật viên -->
                            <VBox spacing="12.0"
                                  style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                                <Label text="Thao Tác Nhanh Kỹ Thuật" style="-fx-text-fill: #102A46; -fx-font-size: 16px; -fx-font-weight: 800;" />
                                
                                <Button text="🔍 Bắt Đầu Kiểm Tra &amp; Chẩn Đoán" maxWidth="Infinity"
                                        styleClass="action-button" />

                                <Button text="📦 Đề Xuất Xuất Kho Phụ Tùng" maxWidth="Infinity"
                                        styleClass="primary-button" />

                                <Button text="🏷️ Tra Cứu Tồn Kho Phụ Tùng" maxWidth="Infinity"
                                        styleClass="secondary-button" />
                            </VBox>

                            <!-- Tình trạng cầu nâng tại xưởng -->
                            <VBox spacing="12.0" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Tình Trạng 5 Cầu Nâng Xưởng" style="-fx-text-fill: #102A46; -fx-font-size: 15px; -fx-font-weight: 800;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label text="4/5 bận" style="-fx-text-fill: #f47b31; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                </HBox>

                                <VBox spacing="8.0">
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 8px 10px; -fx-background-color: #f8fafc; -fx-background-radius: 6px;">
                                        <Label text="Cầu 1" style="-fx-text-fill: #173b61; -fx-font-weight: 900; -fx-font-size: 13px;" />
                                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                            <Label text="51G-678.90 (Honda City)" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                            <Label text="Thay má phanh • Đến 11:15" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                        </VBox>
                                        <Label text="Đang dùng" style="-fx-text-fill: #ea580c; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 8px 10px; -fx-background-color: #f8fafc; -fx-background-radius: 6px;">
                                        <Label text="Cầu 2" style="-fx-text-fill: #173b61; -fx-font-weight: 900; -fx-font-size: 13px;" />
                                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                            <Label text="51F-123.45 (Toyota Vios)" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                            <Label text="Bảo dưỡng 40k • Đến 10:30" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                        </VBox>
                                        <Label text="Đang dùng" style="-fx-text-fill: #ea580c; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 8px 10px; -fx-background-color: #f8fafc; -fx-background-radius: 6px;">
                                        <Label text="Cầu 3" style="-fx-text-fill: #173b61; -fx-font-weight: 900; -fx-font-size: 13px;" />
                                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                            <Label text="30A-554.21 (Mazda 3)" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                            <Label text="Thay rotuyn lái • Đến 11:45" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                        </VBox>
                                        <Label text="Đang dùng" style="-fx-text-fill: #ea580c; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 8px 10px; -fx-background-color: #f8fafc; -fx-background-radius: 6px;">
                                        <Label text="Cầu 4" style="-fx-text-fill: #173b61; -fx-font-weight: 900; -fx-font-size: 13px;" />
                                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                            <Label text="Cầu nâng cắt kéo số 4" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                            <Label text="Sẵn sàng nhận xe tiếp theo" style="-fx-text-fill: #059669; -fx-font-size: 11px;" />
                                        </VBox>
                                        <Label text="Sẵn sàng" style="-fx-text-fill: #059669; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </VBox>

                    </HBox>

                </VBox>
            </ScrollPane>

        </VBox>

    </HBox>

</VBox>
