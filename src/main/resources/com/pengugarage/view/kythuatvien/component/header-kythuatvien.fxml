<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- ================================================================= -->
<!-- COMPONENT HEADER DÀNH CHO ROLE KỸ THUẬT VIÊN (header-kythuatvien.fxml) -->
<!-- Bố cục thanh ngang trên cùng: Light Modern UI, Bảng màu Logo Pengu  -->
<!-- ================================================================= -->

<HBox fx:id="rootHeader" alignment="CENTER_LEFT" prefHeight="58.0" spacing="16.0"
      style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;"
      stylesheets="@../../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.component.HeaderKyThuatVienController">

    <padding>
        <Insets left="20.0" right="20.0" />
    </padding>

    <!-- 1. Logo & Brand Title -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <StackPane maxHeight="38.0" maxWidth="38.0"
                   style="-fx-background-color: #ebf3fa; -fx-background-radius: 8px; -fx-padding: 4px; -fx-border-color: #bfd7ee; -fx-border-radius: 8px;">
            <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../images/logo_pengu-garage.png" />
                </image>
            </ImageView>
        </StackPane>
        <Label style="-fx-text-fill: #102A46; -fx-font-size: 17px; -fx-font-weight: 900; -fx-letter-spacing: 0.6px;"
               text="PENGU GARAGE" />
    </HBox>

    <Region prefWidth="12.0" />

    <!-- 2. Danh mục lớn nằm ngang (Header Tabs) -->
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <!-- Đề mục 1: Dashboard -->
        <Button fx:id="btnHeaderDashboard" onAction="#onDashboardClick"
                styleClass="header-nav-btn" text="📊 Dashboard" />

        <!-- Đề mục 2: Ca sửa chữa & Phân công -->
        <MenuButton fx:id="menuHeaderCaSua"
                    styleClass="header-nav-btn" text="🔧 Ca sửa &amp; Phân công">
            <items>
                <MenuItem onAction="#onPhieuPhanCongClick" text="📋 Phiếu phân công của tôi" />
                <MenuItem onAction="#onKiemTraChanDoanClick" text="🔍 Kiểm tra &amp; Chẩn đoán xe" />
                <MenuItem onAction="#onCapNhatTienDoClick" text="⚙️ Cập nhật tiến độ ca sửa" />
            </items>
        </MenuButton>

        <!-- Đề mục 3: Vật tư & Phụ tùng -->
        <MenuButton fx:id="menuHeaderVatTu"
                    styleClass="header-nav-btn" text="📦 Vật tư &amp; Phụ tùng">
            <items>
                <MenuItem onAction="#onDeXuatVatTuClick" text="📦 Đề xuất xuất kho phụ tùng" />
                <MenuItem onAction="#onTraCuuTonKhoClick" text="🏷️ Tra cứu tồn kho phụ tùng" />
            </items>
        </MenuButton>

        <!-- Đề mục 4: Nhật ký công việc -->
        <MenuButton fx:id="menuHeaderNhatKy"
                    styleClass="header-nav-btn" text="📜 Nhật ký công việc">
            <items>
                <MenuItem onAction="#onLichSuCaSuaClick" text="📜 Lịch sử ca sửa hoàn tất" />
            </items>
        </MenuButton>
    </HBox>

    <Region HBox.hgrow="ALWAYS" />

    <!-- 3. User Badge & Nút Đăng xuất -->
    <HBox alignment="CENTER_RIGHT" spacing="14.0">
        <!-- User avatar & info -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <StackPane maxHeight="36.0" maxWidth="36.0"
                       style="-fx-background-color: #173b61; -fx-background-radius: 50%; -fx-pref-width: 36px; -fx-pref-height: 36px;">
                <Label fx:id="userAvatarLabel"
                       style="-fx-text-fill: #ffffff; -fx-font-weight: 900; -fx-font-size: 14px;"
                       text="B" />
            </StackPane>
            <VBox alignment="CENTER_LEFT" spacing="1.0">
                <Label fx:id="userNameLabel"
                       style="-fx-text-fill: #102A46; -fx-font-weight: 800; -fx-font-size: 13.5px;"
                       text="Trần Gia Bảo" />
                <Label fx:id="userRoleLabel"
                       style="-fx-text-fill: #f47b31; -fx-font-size: 12px; -fx-font-weight: 700;"
                       text="Kỹ thuật viên" />
            </VBox>
        </HBox>

        <!-- Divider line -->
        <Region prefHeight="24.0" prefWidth="1.0" style="-fx-background-color: #e2e8f0;" />

        <!-- Nút Đăng xuất -->
        <Button onAction="#onLogoutClick"
                style="-fx-background-color: #fef2f2; -fx-text-fill: #dc2626; -fx-border-color: #fecaca; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 12.5px; -fx-font-weight: 700; -fx-padding: 6px 12px; -fx-cursor: hand;"
                text="Đăng xuất" />
    </HBox>

</HBox>

