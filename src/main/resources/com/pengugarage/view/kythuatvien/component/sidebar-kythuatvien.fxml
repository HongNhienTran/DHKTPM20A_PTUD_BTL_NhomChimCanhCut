<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ================================================================= -->
<!-- COMPONENT SIDEBAR DÀNH CHO KỸ THUẬT VIÊN (sidebar-kythuatvien.fxml) -->
<!-- Bố cục thanh dọc bên trái có thể ĐÓNG / MỞ (Toggle Collapsible)   -->
<!-- Tone màu: Light Modern UI, Active Brand Navy #173B61              -->
<!-- ================================================================= -->

<VBox fx:id="rootSidebar" minWidth="60.0" prefWidth="230.0"
      style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 1px 0 0;"
      stylesheets="@../../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.component.SidebarKyThuatVienController">

    <!-- 1. Header Sidebar: Tên phân mục đang xem + Nút Toggle Đóng/Mở (< / >) -->
    <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="6.0"
          style="-fx-padding: 10px 14px; -fx-border-color: #f1f5f9; -fx-border-width: 0 0 1px 0; -fx-background-color: #ffffff;">
        <Label fx:id="lblTenHangMuc"
               style="-fx-text-fill: #102A46; -fx-font-size: 11.5px; -fx-font-weight: 900; -fx-letter-spacing: 0.6px;"
               text="KHÔNG GIAN KỸ THUẬT" HBox.hgrow="ALWAYS" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnToggleSidebar" onAction="#onToggleSidebarClick"
                style="-fx-background-color: #f4f7fa; -fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 12px; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-cursor: hand; -fx-padding: 3px 8px;"
                text="&lt;" />
    </HBox>

    <!-- 2. Danh sách các nhóm chức năng -->
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
        <VBox fx:id="boxChucNang" spacing="4.0" style="-fx-padding: 10px 10px;">
            
            <!-- Dashboard Kỹ Thuật Viên -->
            <Button fx:id="btnDashboard" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDashboardClick"
                    styleClass="sidebar-nav-btn" text="📊 Dashboard Kỹ thuật" />

            <!-- Nhóm 1: Ca sửa chữa & Phân công -->
            <Label fx:id="lblSectionCaSua" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 12px 6px 4px 6px;" text="CA SỬA &amp; PHÂN CÔNG" />
            <Button fx:id="btnPhieuPhanCong" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onPhieuPhanCongClick"
                    styleClass="sidebar-nav-btn" text="📋 Phiếu phân công của tôi" />
            <Button fx:id="btnKiemTraChanDoan" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onKiemTraChanDoanClick"
                    styleClass="sidebar-nav-btn" text="🔍 Kiểm tra &amp; Chẩn đoán xe" />
            <Button fx:id="btnCapNhatTienDo" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onCapNhatTienDoClick"
                    styleClass="sidebar-nav-btn" text="⚙️ Cập nhật tiến độ ca sửa" />

            <!-- Nhóm 2: Vật tư & Phụ tùng -->
            <Label fx:id="lblSectionVatTu" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 12px 6px 4px 6px;" text="VẬT TƯ &amp; PHỤ TÙNG" />
            <Button fx:id="btnDeXuatVatTu" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDeXuatVatTuClick"
                    styleClass="sidebar-nav-btn" text="📦 Đề xuất xuất kho phụ tùng" />
            <Button fx:id="btnTraCuuTonKho" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTraCuuTonKhoClick"
                    styleClass="sidebar-nav-btn" text="🏷️ Tra cứu tồn kho phụ tùng" />

            <!-- Nhóm 3: Nhật ký -->
            <Label fx:id="lblSectionNhatKy" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 12px 6px 4px 6px;" text="NHẬT KÝ CÔNG VIỆC" />
            <Button fx:id="btnLichSuCaSua" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onLichSuCaSuaClick"
                    styleClass="sidebar-nav-btn" text="📜 Lịch sử ca sửa hoàn tất" />
        </VBox>
    </ScrollPane>

    <!-- 3. Footer Sidebar: Hướng dẫn sử dụng (Dấu chấm than ❗) -->
    <VBox alignment="CENTER" style="-fx-padding: 8px 10px; -fx-border-color: #f1f5f9; -fx-border-width: 1px 0 0 0; -fx-background-color: #ffffff;">
        <Button fx:id="btnHuongDanSuDung" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onHuongDanSuDungClick"
                styleClass="sidebar-nav-btn" text="❗ Hướng dẫn sử dụng" />
    </VBox>

</VBox>
