<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- ================================================================= -->
<!-- COMPONENT SIDEBAR DÀNH CHO KỸ THUẬT VIÊN                          -->
<!-- ================================================================= -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.component.SidebarKyThuatVienController"
      prefWidth="250.0" minWidth="250.0"
      stylesheets="@../../../css/style.css"
      style="-fx-background-color: #0d1826; -fx-border-color: #1a2f47; -fx-border-width: 0 1px 0 0;">

    <!-- Logo Gara -->
    <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 20px 16px 16px 16px;">
        <StackPane alignment="CENTER" maxWidth="100.0" maxHeight="100.0" styleClass="brand-logo-frame" style="-fx-padding: 6px;">
            <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../images/logo_pengu-garage.png" />
                </image>
            </ImageView>
        </StackPane>
        <Label text="PENGU GARAGE" styleClass="sidebar-brand-title" />
        <Label text="KHÔNG GIAN KỸ THUẬT VIÊN" style="-fx-text-fill: #f47b31; -fx-font-size: 11px; -fx-font-weight: 800; -fx-letter-spacing: 1px;" />
    </VBox>

    <!-- Menu Kỹ Thuật Viên -->
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
        <VBox spacing="4.0" style="-fx-padding: 10px 12px;">
            
            <!-- Dashboard KTV (Active) -->
            <Button fx:id="btnDashboard" text="DASHBOARD KỸ THUẬT" onAction="#onDashboardClick" maxWidth="Infinity" alignment="CENTER_LEFT"
                    styleClass="sidebar-nav-btn-active" />

            <!-- Nhóm: Công việc sửa chữa -->
            <Label text="CA SỬA CHỮA &amp; PHÂN CÔNG" styleClass="sidebar-section-title" />
            <Button text="Phiếu phân công của tôi" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-nav-btn" />
            <Button text="Kiểm tra &amp; Chẩn đoán xe" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-nav-btn" />
            <Button text="Cập nhật tiến độ ca sửa" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-nav-btn" />

            <!-- Nhóm: Vật tư & Phụ tùng -->
            <Label text="VẬT TƯ &amp; PHỤ TÙNG" styleClass="sidebar-section-title" />
            <Button text="Đề xuất xuất kho phụ tùng" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-nav-btn" />
            <Button text="Tra cứu tồn kho phụ tùng" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-nav-btn" />

            <!-- Nhóm: Nhật ký -->
            <Label text="NHẬT KÝ &amp; LỊCH SỬ" styleClass="sidebar-section-title" />
            <Button text="Lịch sử ca sửa hoàn tất" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-nav-btn" />
        </VBox>
    </ScrollPane>

    <!-- Bottom User Info -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 14px 16px; -fx-border-color: #1a2f47; -fx-border-width: 1px 0 0 0; -fx-background-color: #0b1420;">
        <StackPane style="-fx-background-color: #1f4f82; -fx-background-radius: 20px; -fx-min-width: 36px; -fx-min-height: 36px;">
            <Label fx:id="userAvatarLabel" text="B" style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 15px;" />
        </StackPane>
        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
            <Label fx:id="userNameLabel" text="Trần Gia Bảo" style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13px;" />
            <Label fx:id="userRoleLabel" text="Kỹ thuật viên" style="-fx-text-fill: #f47b31; -fx-font-size: 11px; -fx-font-weight: bold;" />
        </VBox>
        <Button text="Đăng xuất" onAction="#onLogoutClick"
                style="-fx-background-color: #16283c; -fx-text-fill: #e06c75; -fx-font-size: 11px; -fx-font-weight: bold; -fx-border-color: #2b415a; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 10px; -fx-cursor: hand;" />
    </HBox>
</VBox>
