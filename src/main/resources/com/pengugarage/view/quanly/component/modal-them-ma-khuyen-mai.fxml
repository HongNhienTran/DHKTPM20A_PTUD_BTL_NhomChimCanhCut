<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- MODAL THÊM MÃ KHUYẾN MÃI MỚI                                         -->
<!-- Tone màu: Slate Navy Card #182e47, Viền #27456b                       -->
<!-- Người thực hiện: Tuấn (Task M03-T02)                                 -->
<!-- ===================================================================== -->

<VBox fx:id="rootPane" prefWidth="580.0" spacing="18.0"
      style="-fx-background-color: #182e47; -fx-border-color: #27456b; -fx-border-width: 2px; -fx-border-radius: 12px; -fx-background-radius: 12px;"
      stylesheets="@../../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.component.ModalThemMaKhuyenMaiController">

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>

    <!-- Header Modal -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0">
            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: 900;"
                   text="🏷️ Thêm Mã Khuyến Mãi Mới" />
            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"
                   text="Nhập thông tin voucher ưu đãi gara (Task M03-T02 - Tuấn)" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onDongClick"
                style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand;"
                text="✕" />
    </HBox>

    <!-- Form Nhập Liệu -->
    <GridPane hgap="14.0" vgap="14.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="160.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" />
        </columnConstraints>

        <!-- Mã Khuyến Mãi -->
        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 13px;"
               text="Mã khuyến mãi (*):" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="maKMField" promptText="VD: KM-HE2026, GIAM50K..."
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <!-- Loại Giảm Giá -->
        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 13px;"
               text="Loại giảm giá:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <ComboBox fx:id="loaiGiamCombo" prefWidth="250.0"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 3px;"
                  GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <!-- Giá Trị Giảm -->
        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 13px;"
               text="Giá trị giảm (*):" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <TextField fx:id="giaTriGiamField" promptText="VD: 10 (cho %) hoặc 50000 (cho VNĐ)"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;"
                   GridPane.rowIndex="2" GridPane.columnIndex="1" />

        <!-- Giá Trị Tối Thiểu Áp Dụng -->
        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 13px;"
               text="Hóa đơn tối thiểu (VNĐ):" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <TextField fx:id="giaTriToiThieuField" promptText="VD: 500000"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;"
                   GridPane.rowIndex="3" GridPane.columnIndex="1" />

        <!-- Ngày Bắt Đầu Áp Dụng -->
        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 13px;"
               text="Ngày bắt đầu (Lịch chọn):" GridPane.rowIndex="4" GridPane.columnIndex="0" />
        <DatePicker fx:id="ngayBatDauPicker" promptText="dd/MM/yyyy" maxWidth="Infinity"
                    style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px;"
                    GridPane.rowIndex="4" GridPane.columnIndex="1" />

        <!-- Ngày Hết Hạn -->
        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 13px;"
               text="Ngày hết hạn (Lịch chọn):" GridPane.rowIndex="5" GridPane.columnIndex="0" />
        <DatePicker fx:id="ngayHetHanPicker" promptText="dd/MM/yyyy" maxWidth="Infinity"
                    style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px;"
                    GridPane.rowIndex="5" GridPane.columnIndex="1" />


        <!-- Số Lượng Tồn / Phát Hành -->
        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 13px;"
               text="Số lượng phát hành:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
        <TextField fx:id="soLuongTonField" promptText="VD: 100"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;"
                   GridPane.rowIndex="6" GridPane.columnIndex="1" />

        <!-- Trạng Thái -->
        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 13px;"
               text="Trạng thái:" GridPane.rowIndex="7" GridPane.columnIndex="0" />
        <ComboBox fx:id="trangThaiCombo" prefWidth="250.0"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 3px;"
                  GridPane.rowIndex="7" GridPane.columnIndex="1" />
    </GridPane>

    <!-- Nhãn thông báo -->
    <Label fx:id="thongBaoLabel" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="" />

    <!-- Footer Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button onAction="#onDongClick"
                style="-fx-background-color: #223e60; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 8px; -fx-cursor: hand;"
                text="Hủy bỏ" />
        <Button onAction="#onLuuClick"
                style="-fx-background-color: #f47b31; -fx-text-fill: #ffffff; -fx-font-weight: 800; -fx-padding: 10px 24px; -fx-background-radius: 8px; -fx-cursor: hand;"
                text="Lưu Khuyến Mãi" />
    </HBox>

</VBox>
