<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ================================================================= -->
<!-- COMPONENT SIDEBAR DÀNH CHO QUẢN LÝ (sidebar-quanly.fxml)          -->
<!-- Bố cục thanh dọc bên trái có thể ĐÓNG / MỞ (Toggle Collapsible)   -->
<!-- Tone màu: Light Modern UI, Active xanh chính #2563eb             -->
<!-- ================================================================= -->

<VBox fx:id="rootSidebar" minWidth="60.0" prefWidth="230.0"
      style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 1px 0 0;"
      stylesheets="@../../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.component.SidebarQuanLyController">

    <!-- 1. Header Sidebar: Tên phân mục đang xem + Nút Toggle Đóng/Mở (< / >) -->
    <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="6.0"
          style="-fx-padding: 10px 14px; -fx-border-color: #f1f5f9; -fx-border-width: 0 0 1px 0; -fx-background-color: #ffffff;">
        <Label fx:id="lblTenHangMuc"
               style="-fx-text-fill: #102A46; -fx-font-size: 12px; -fx-font-weight: 900; -fx-letter-spacing: 0.6px;"
               text="HẠNG MỤC CUNG CẤP" HBox.hgrow="ALWAYS" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnToggleSidebar" onAction="#onToggleSidebarClick"
                style="-fx-background-color: #f4f7fa; -fx-text-fill: #102A46; -fx-font-weight: 900; -fx-font-size: 12px; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-cursor: hand; -fx-padding: 3px 8px;"
                text="&lt;" />
    </HBox>

    <!-- 2. Danh sách các nhóm chức năng -->
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
        <VBox fx:id="boxChucNang" spacing="4.0" style="-fx-padding: 10px 10px;">
            
            <!-- Dashboard -->
            <Button fx:id="btnDashboard" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDashboardClick"
                    styleClass="sidebar-nav-btn" text="📊 Dashboard" />

            <!-- Nhóm 1: Hạng mục cung cấp -->
            <Label fx:id="lblSectionCungCap" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 12px 6px 4px 6px;" text="HẠNG MỤC CUNG CẤP" />
            <Button fx:id="btnQuanLySanPham" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onQuanLySanPhamClick"
                    styleClass="sidebar-nav-btn" text="📦 Sản phẩm &amp; Phụ tùng" />
            <Button fx:id="btnQuanLyDichVu" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onQuanLyDichVuClick"
                    styleClass="sidebar-nav-btn" text="🔧 Dịch vụ kỹ thuật" />
            <Button fx:id="btnQuanLyMaKhuyenMai" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onQuanLyMaKhuyenMaiClick"
                    styleClass="sidebar-nav-btn" text="🏷️ Mã khuyến mãi" />

            <!-- Nhóm 2: Vận hành -->
            <Label fx:id="lblSectionVanHanh" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 12px 6px 4px 6px;" text="VẬN HÀNH GARA" />
            <Button fx:id="btnQuanLyPhuongTien" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onQuanLyPhuongTienClick"
                    styleClass="sidebar-nav-btn" text="🚗 Quản lý phương tiện" />
            <Button fx:id="btnQuanLyHoaDon" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onQuanLyHoaDonClick"
                    styleClass="sidebar-nav-btn" text="🧾 Quản lý hóa đơn" />
            <Button fx:id="btnQuanLyKhachHang" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onQuanLyKhachHangClick"
                    styleClass="sidebar-nav-btn" text="👥 Quản lý khách hàng" />

            <!-- Nhóm 3: Quản trị cửa hàng -->
            <Label fx:id="lblSectionQuanTri" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 800; -fx-padding: 12px 6px 4px 6px;" text="QUẢN TRỊ CỬA HÀNG" />
            <Button fx:id="btnQuanLyNhanVien" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onQuanLyNhanVienClick"
                    styleClass="sidebar-nav-btn" text="👨‍🔧 Quản lý nhân viên" />
            <Button fx:id="btnBaoCaoThongKe" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onBaoCaoThongKeClick"
                    styleClass="sidebar-nav-btn" text="📊 Báo cáo &amp; Thống kê" />
        </VBox>
    </ScrollPane>

    <!-- 3. Footer Sidebar: Hướng dẫn sử dụng (Dấu chấm than ❗) -->
    <VBox alignment="CENTER" style="-fx-padding: 8px 10px; -fx-border-color: #f1f5f9; -fx-border-width: 1px 0 0 0; -fx-background-color: #ffffff;">
        <Button fx:id="btnHuongDanSuDung" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onHuongDanSuDungClick"
                styleClass="sidebar-nav-btn" text="❗ Hướng dẫn sử dụng" />
    </VBox>

</VBox>
