<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- COMPONENT XEM & CHỈNH SỬA CHI TIẾT DỊCH VỤ (chi-tiet-dich-vu.fxml)     -->
<!-- Bố cục dạng Form mở rộng phía dưới bảng, các ô input nền TRẮNG (#FFFFFF) -->
<!-- ===================================================================== -->

<VBox fx:id="rootPane" spacing="14.0"
      style="-fx-background-color: #182e47; -fx-border-color: #27456b; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 18px 24px;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.component.ChiTietDichVuController">

    <!-- 1. Header Panel: Tiêu đề + Mã DV + Nút Đóng -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label style="-fx-text-fill: #f47b31; -fx-font-weight: 800; -fx-font-size: 14px; -fx-letter-spacing: 0.5px;"
               text="CHI TIẾT &amp; CHỈNH SỬA DỊCH VỤ" />
        <Label fx:id="detailMaDVLabel"
               style="-fx-background-color: #0d1a29; -fx-border-color: #27456b; -fx-border-radius: 4px; -fx-text-fill: #38bdf8; -fx-padding: 3px 10px; -fx-background-radius: 4px; -fx-font-weight: bold; -fx-font-size: 11px;"
               text="---" />

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="thongBaoLuuLabel" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="" />

        <Button onAction="#onDongClick"
                style="-fx-background-color: #223e60; -fx-text-fill: #cbd5e1; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand; -fx-padding: 6px 14px;"
                text="✕ Đóng" />
    </HBox>

    <Separator style="-fx-opacity: 0.15;" />

    <!-- 2. Form chỉnh sửa các trường -->
    <HBox spacing="24.0" alignment="TOP_LEFT">

        <!-- Khối 1: Các trường thông số cơ bản (Trái) -->
        <VBox spacing="12.0" prefWidth="540.0">
            <!-- Hàng 1: Tên dịch vụ + Trạng thái -->
            <HBox spacing="14.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px; -fx-font-weight: bold;"
                           text="TÊN DỊCH VỤ KỸ THUẬT (*)" />
                    <TextField fx:id="tenDichVuField" promptText="Nhập tên dịch vụ..."
                               style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;" />
                </VBox>
                <VBox spacing="4.0" prefWidth="180.0">
                    <Label style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px; -fx-font-weight: bold;"
                           text="TRẠNG THÁI ÁP DỤNG" />
                    <ComboBox fx:id="trangThaiCombo" maxWidth="Infinity"
                              style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 3px;"
                              styleClass="light-combo-box" />
                </VBox>
            </HBox>

            <!-- Hàng 2: Đơn giá + Thuế VAT -->
            <HBox spacing="14.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px; -fx-font-weight: bold;"
                           text="ĐƠN GIÁ DỊCH VỤ (VNĐ) (*)" />
                    <TextField fx:id="donGiaField" promptText="0"
                               style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #EA580C; -fx-font-weight: 800; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;" />
                </VBox>
                <VBox spacing="4.0" prefWidth="180.0">
                    <Label style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px; -fx-font-weight: bold;"
                           text="THUẾ VAT (%)" />
                    <TextField fx:id="thueVATField" promptText="10.0"
                               style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #0F172A; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Khối 2: Mô tả dịch vụ + Nút Lưu (Phải) -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px; -fx-font-weight: bold;"
                   text="MÔ TẢ CHI TIẾT / HẠNG MỤC THỰC HIỆN" />
            <TextArea fx:id="moTaArea" prefRowCount="3" promptText="Nhập quy trình, các bước kỹ thuật, công cụ hỗ trợ..."
                      style="-fx-control-inner-background: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-background-radius: 6px; -fx-border-radius: 6px;"
                      wrapText="true" VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button fx:id="btnLuuThayDoi" onAction="#onLuuThayDoiClick"
                        style="-fx-background-color: #f47b31; -fx-text-fill: #ffffff; -fx-font-weight: 800; -fx-font-size: 13px; -fx-padding: 9px 24px; -fx-background-radius: 6px; -fx-cursor: hand;"
                        text="💾 Lưu Thay Đổi Dịch Vụ" />
            </HBox>
        </VBox>
    </HBox>
</VBox>
