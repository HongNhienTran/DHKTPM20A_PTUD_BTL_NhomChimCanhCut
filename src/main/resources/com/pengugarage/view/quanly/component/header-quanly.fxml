<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- ================================================================= -->
<!-- COMPONENT HEADER DÀNH CHO ROLE QUẢN LÝ (header-quanly.fxml)      -->
<!-- Bố cục thanh ngang trên cùng phối màu theo chuẩn Logo Pengu       -->
<!-- Brand Navy #102A46, Action Orange #F47B31, Surface White #FFFFFF  -->
<!-- ================================================================= -->

<HBox fx:id="rootHeader" alignment="CENTER_LEFT" prefHeight="58.0" spacing="16.0"
      style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;"
      stylesheets="@../../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.component.HeaderQuanLyController">

    <padding>
        <Insets left="20.0" right="20.0" />
    </padding>

    <!-- 1. Logo & Brand Title -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <StackPane maxHeight="38.0" maxWidth="38.0"
                   style="-fx-background-color: #ebf3fa; -fx-background-radius: 8px; -fx-padding: 4px; -fx-border-color: #bfd7ee; -fx-border-radius: 8px;">
            <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../images/logo_pengu-garage.png" />
                </image>
            </ImageView>
        </StackPane>
        <Label style="-fx-text-fill: #102A46; -fx-font-size: 16px; -fx-font-weight: 900; -fx-letter-spacing: 0.6px;"
               text="PENGU GARAGE" />
    </HBox>

    <Region prefWidth="16.0" />

    <!-- 2. Danh mục lớn nằm ngang (Header Tabs) -->
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <!-- Đề mục 1: Dashboard -->
        <Button fx:id="btnHeaderDashboard" onAction="#onDashboardClick"
                styleClass="header-nav-btn" text="📊 Dashboard" />

        <!-- Đề mục 2: Hạng mục cung cấp (sổ ra Sản phẩm, Dịch vụ, Khuyến mãi) -->
        <MenuButton fx:id="menuHeaderCungCap"
                    styleClass="header-nav-btn" text="📦 Hạng mục cung cấp">
            <items>
                <MenuItem onAction="#onQuanLySanPhamClick" text="📦 Quản lý sản phẩm &amp; phụ tùng" />
                <MenuItem onAction="#onQuanLyDichVuClick" text="🔧 Quản lý dịch vụ kỹ thuật" />
                <MenuItem onAction="#onQuanLyMaKhuyenMaiClick" text="🏷️ Quản lý mã khuyến mãi" />
            </items>
        </MenuButton>

        <!-- Đề mục 3: Hạng mục vận hành (sổ ra Phương tiện, Hóa đơn, Khách hàng) -->
        <MenuButton fx:id="menuHeaderVanHanh"
                    styleClass="header-nav-btn" text="🚗 Hạng mục vận hành">
            <items>
                <MenuItem onAction="#onQuanLyPhuongTienClick" text="🚗 Quản lý phương tiện" />
                <MenuItem onAction="#onQuanLyHoaDonClick" text="🧾 Quản lý hóa đơn" />
                <MenuItem onAction="#onQuanLyKhachHangClick" text="👥 Quản lý khách hàng" />
            </items>
        </MenuButton>

        <!-- Đề mục 4: Quản trị cửa hàng (sổ ra Nhân viên, Thống kê) -->
        <MenuButton fx:id="menuHeaderQuanTri"
                    styleClass="header-nav-btn" text="⚙️ Quản trị cửa hàng">
            <items>
                <MenuItem onAction="#onQuanLyNhanVienClick" text="👨‍🔧 Quản lý nhân viên" />
                <MenuItem onAction="#onBaoCaoThongKeClick" text="📊 Báo cáo &amp; Thống kê" />
            </items>
        </MenuButton>
    </HBox>

    <Region HBox.hgrow="ALWAYS" />

    <!-- 3. User Badge & Nút Đăng xuất -->
    <HBox alignment="CENTER_RIGHT" spacing="14.0">
        <!-- User avatar & info -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <StackPane maxHeight="34.0" maxWidth="34.0"
                       style="-fx-background-color: #102A46; -fx-background-radius: 50%; -fx-pref-width: 34px; -fx-pref-height: 34px;">
                <Label fx:id="userAvatarLabel"
                       style="-fx-text-fill: #F47B31; -fx-font-weight: 900; -fx-font-size: 13.5px;"
                       text="T" />
            </StackPane>
            <VBox alignment="CENTER_LEFT" spacing="1.0">
                <Label fx:id="userNameLabel"
                       style="-fx-text-fill: #102A46; -fx-font-weight: 800; -fx-font-size: 12.5px;"
                       text="Nguyễn Minh Tuấn" />
                <Label fx:id="userRoleLabel"
                       style="-fx-text-fill: #ea580c; -fx-font-size: 11px; -fx-font-weight: 700;"
                       text="Quản lý" />
            </VBox>
        </HBox>

        <!-- Nút Đăng Xuất -->
        <Button onAction="#onLogoutClick"
                style="-fx-background-color: #fff1f2; -fx-text-fill: #e11d48; -fx-font-size: 11.5px; -fx-font-weight: 700; -fx-border-color: #fecdd3; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 5px 12px; -fx-cursor: hand;"
                text="Đăng xuất" />
    </HBox>

</HBox>
