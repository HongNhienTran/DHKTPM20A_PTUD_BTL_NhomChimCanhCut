<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- MÀN HÌNH QUẢN LÝ DỊCH VỤ SỬA CHỮA GARA (dich-vu-view.fxml)            -->
<!-- Tone màu: Light Modern UI, Header đề mục lớn, Sidebar đóng mở,        -->
<!-- Nền vùng làm việc Trắng #FFFFFF / #F8FAFC sáng sủa, dễ quan sát      -->
<!-- ===================================================================== -->

<VBox prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.DichVuController">

    <!-- 1. Thanh Header Quản Lý bên trên (Các đề mục lớn) -->
    <fx:include source="component/header-quanly.fxml" />

    <!-- 2. Thân Trang: Sidebar đóng mở bên trái + Vùng nội dung chính -->
    <HBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

        <!-- Sidebar bên trái -->
        <fx:include source="component/sidebar-quanly.fxml" />

        <!-- Vùng Nội Dung Làm Việc Chính (Nền Trắng #f8fafc) -->
        <VBox spacing="16.0" style="-fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>

            <!-- Top Title & Action Bar -->
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #102A46; -fx-font-size: 24px; -fx-font-weight: 900;"
                           text="Dịch Vụ Sửa Chữa &amp; Bảo Dưỡng" />
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;"
                           text="Danh mục các gói công sửa chữa, kiểm tra, bảo dưỡng kỹ thuật xe hơi" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="thongBaoLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="" />

                <!-- Nút Thêm Dịch Vụ Mới: Màu Cam Thương Hiệu #F47B31 trích từ logo -->
                <Button onAction="#onThemMoiClick"
                        style="-fx-background-color: #f47b31; -fx-text-fill: #ffffff; -fx-font-weight: 800; -fx-font-size: 12.5px; -fx-padding: 9px 18px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(244,123,49,0.3), 8, 0, 0, 2);"
                        text="➕ Thêm Dịch Vụ Mới" />
            </HBox>

            <!-- Toolbar Tìm Kiếm & Lọc: Card Nền Trắng (#ffffff) -->
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: #ffffff; -fx-padding: 12px 18px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                <TextField fx:id="timKiemField"
                           promptText="🔍 Tìm kiếm theo Mã DV, Tên dịch vụ, Mô tả..."
                           style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-padding: 8px 16px; -fx-background-radius: 20px; -fx-border-radius: 20px; -fx-font-size: 13px;"
                           HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="locTrangThaiCombo" prefWidth="170.0" promptText="Trạng thái"
                          style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 3px;"
                          styleClass="light-combo-box" />

                <Button onAction="#onTimKiemClick"
                        style="-fx-background-color: #173B61; -fx-text-fill: #ffffff; -fx-font-weight: 700; -fx-font-size: 12.5px; -fx-padding: 8px 18px; -fx-background-radius: 8px; -fx-cursor: hand;"
                        text="Tìm Kiếm" />

                <Button graphicTextGap="0.0" onAction="#onLamMoiClick"
                        style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-text-fill: #334155; -fx-padding: 8px 14px; -fx-background-radius: 8px; -fx-cursor: hand;"
                        text="🔄" />
            </HBox>

            <!-- Main Content: Bảng Danh Sách Dịch Vụ Nền Trắng + Chi Tiết Sổ Phía Dưới -->
            <VBox spacing="12.0" VBox.vgrow="ALWAYS">

                <!-- Card Bảng Danh Sách -->
                <VBox spacing="10.0"
                      style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);"
                      VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: #102A46; -fx-font-weight: 800; -fx-font-size: 15px;"
                               text="Danh Sách Các Dịch Vụ Kỹ Thuật" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="tongSoLabel" alignment="CENTER_RIGHT"
                               style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-padding: 4px 12px; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 12px;"
                               text="Tổng số: 0 dịch vụ" />
                    </HBox>

                    <TableView fx:id="dichVuTable" styleClass="light-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMaDV" prefWidth="100.0" text="Mã DV" />
                            <TableColumn fx:id="colTenDV" prefWidth="300.0" text="Tên Dịch Vụ" />
                            <TableColumn fx:id="colMoTa" prefWidth="380.0" text="Mô Tả Kỹ Thuật" />
                            <TableColumn fx:id="colDonGia" prefWidth="150.0" text="Đơn Giá" />
                            <TableColumn fx:id="colThueVAT" prefWidth="90.0" text="VAT" />
                            <TableColumn fx:id="colTrangThai" prefWidth="120.0" text="Trạng Thái" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Khung Xem & Chỉnh Sửa Chi Tiết Dịch Vụ (Sổ ra phía dưới khi chọn dòng) -->
                <fx:include fx:id="chiTietDichVu" source="component/chi-tiet-dich-vu.fxml" />
            </VBox>
        </VBox>
    </HBox>
</VBox>
