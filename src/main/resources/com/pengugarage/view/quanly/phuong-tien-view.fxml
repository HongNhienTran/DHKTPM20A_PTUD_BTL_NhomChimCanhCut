<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- MÀN HÌNH QUẢN LÝ PHƯƠNG TIỆN XE HƠI GARA (phuong-tien-view.fxml)      -->
<!-- Dành cho Quản lý: Theo dõi danh sách xe hơi, thông số, chủ sở hữu    -->
<!-- Tone màu: Light Modern UI, Header lớn, Sidebar đóng mở linh hoạt      -->
<!-- ===================================================================== -->

<VBox prefHeight="780.0" prefWidth="1300.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.PhuongTienController">

    <!-- 1. Thanh Header Quản Lý bên trên -->
    <fx:include source="component/header-quanly.fxml" />

    <!-- 2. Thân Trang: Sidebar đóng mở bên trái + Vùng nội dung chính -->
    <HBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

        <!-- Sidebar Quản lý bên trái -->
        <fx:include source="component/sidebar-quanly.fxml" />

        <!-- Vùng Nội Dung Làm Việc Chính -->
        <VBox spacing="14.0" style="-fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
            </padding>

            <!-- Top Title & Action Bar -->
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="3.0">
                    <Label style="-fx-text-fill: #102A46; -fx-font-size: 24px; -fx-font-weight: 900;"
                           text="Quản Lý Phương Tiện Xe Hơi" />
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 13.5px;"
                           text="Theo dõi hồ sơ phương tiện, thông số kỹ thuật, lịch sử bảo dưỡng và chủ sở hữu xe tại xưởng" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="thongBaoLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="" />

                <!-- Nút Xuất Báo Cáo / Excel -->
                <Button onAction="#onXuatExcelClick"
                        style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #102A46; -fx-font-weight: 700; -fx-font-size: 13px; -fx-padding: 9px 16px; -fx-cursor: hand;"
                        text="📥 Xuất Danh Sách" />

                <!-- Nút Thêm Mới Phương Tiện (Màu cam thương hiệu #F47B31) -->
                <Button onAction="#onThemMoiClick"
                        style="-fx-background-color: #f47b31; -fx-text-fill: #ffffff; -fx-font-weight: 800; -fx-font-size: 13px; -fx-padding: 9px 18px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(244,123,49,0.3), 8, 0, 0, 2);"
                        text="➕ Thêm Phương Tiện Mới" />
            </HBox>

            <!-- 4 Thẻ KPI Thống Kê Nhanh -->
            <HBox spacing="14.0">
                <!-- Thẻ 1: Tổng số xe -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-background-color: #ffffff; -fx-padding: 12px 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 1);"
                      HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 26px;" text="🚗" />
                    <VBox spacing="1.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: 600;" text="TỔNG SỐ PHƯƠNG TIỆN" />
                        <Label fx:id="lblTongSoXeKpi" style="-fx-text-fill: #102a46; -fx-font-size: 19px; -fx-font-weight: 900;" text="5 xe" />
                    </VBox>
                </HBox>

                <!-- Thẻ 2: Xe đang tại xưởng -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-background-color: #ffffff; -fx-padding: 12px 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 1);"
                      HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 26px;" text="⏳" />
                    <VBox spacing="1.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: 600;" text="ĐANG PHỤC VỤ TẠI XƯỞNG" />
                        <Label fx:id="lblXeDangSuaKpi" style="-fx-text-fill: #f47b31; -fx-font-size: 19px; -fx-font-weight: 900;" text="2 xe" />
                    </VBox>
                </HBox>

                <!-- Thẻ 3: Hãng xe phổ biến nhất -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-background-color: #ffffff; -fx-padding: 12px 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 1);"
                      HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 26px;" text="⭐" />
                    <VBox spacing="1.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: 600;" text="HÃNG XE PHỔ BIẾN" />
                        <Label fx:id="lblHangXePhoBienKpi" style="-fx-text-fill: #2563eb; -fx-font-size: 19px; -fx-font-weight: 900;" text="Toyota / Honda" />
                    </VBox>
                </HBox>

                <!-- Thẻ 4: Chủ xe đăng ký thành viên -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-background-color: #ffffff; -fx-padding: 12px 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 1);"
                      HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 26px;" text="👥" />
                    <VBox spacing="1.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: 600;" text="CHỦ SỞ HỮU ĐÃ ĐĂNG KÝ" />
                        <Label fx:id="lblKhachHangKpi" style="-fx-text-fill: #059669; -fx-font-size: 19px; -fx-font-weight: 900;" text="100% Hồ sơ" />
                    </VBox>
                </HBox>
            </HBox>

            <!-- Toolbar Tìm Kiếm & Lọc: Card Nền Trắng (#ffffff) -->
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: #ffffff; -fx-padding: 12px 18px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                <TextField fx:id="timKiemField"
                           promptText="🔍 Tìm kiếm theo Biển số xe, Dòng xe, Tên chủ xe, SĐT..."
                           style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-padding: 8px 16px; -fx-background-radius: 20px; -fx-border-radius: 20px; -fx-font-size: 13.5px;"
                           HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="locHangXeCombo" prefWidth="170.0" promptText="Tất cả hãng xe"
                          style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 3px; -fx-font-size: 13px;"
                          styleClass="light-combo-box" />

                <ComboBox fx:id="locNhienLieuCombo" prefWidth="160.0" promptText="Nhiên liệu"
                          style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 3px; -fx-font-size: 13px;"
                          styleClass="light-combo-box" />

                <ComboBox fx:id="locNamSxCombo" prefWidth="140.0" promptText="Năm sản xuất"
                          style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 3px; -fx-font-size: 13px;"
                          styleClass="light-combo-box" />

                <Button onAction="#onTimKiemClick"
                        style="-fx-background-color: #173B61; -fx-text-fill: #ffffff; -fx-font-weight: 700; -fx-font-size: 13px; -fx-padding: 8px 18px; -fx-background-radius: 8px; -fx-cursor: hand;"
                        text="Tìm Kiếm" />

                <Button graphicTextGap="0.0" onAction="#onLamMoiClick"
                        style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-text-fill: #334155; -fx-padding: 8px 14px; -fx-background-radius: 8px; -fx-cursor: hand;"
                        text="🔄" />
            </HBox>

            <!-- Main Content: Bảng Danh Sách Xe (Trái) + Form Chi Tiết Hồ Sơ (Phải) -->
            <HBox spacing="16.0" VBox.vgrow="ALWAYS">

                <!-- 1. Bảng Danh Sách Phương Tiện: Card Nền Trắng -->
                <VBox spacing="10.0"
                      style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);"
                      HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: #102A46; -fx-font-weight: 800; -fx-font-size: 16px;"
                               text="Danh Sách Phương Tiện Đã Đăng Ký" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="tongSoLabel"
                               style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-padding: 4px 14px; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 12.5px;"
                               text="Tổng số: 0 phương tiện" />
                    </HBox>

                    <TableView fx:id="phuongTienTable" styleClass="light-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMaPT" prefWidth="85.0" text="Mã PT" />
                            <TableColumn fx:id="colBienSo" prefWidth="120.0" text="Biển Số Xe" />
                            <TableColumn fx:id="colHangXe" prefWidth="105.0" text="Hãng Xe" />
                            <TableColumn fx:id="colMauXe" prefWidth="130.0" text="Dòng / Mẫu Xe" />
                            <TableColumn fx:id="colMauSac" prefWidth="85.0" text="Màu Sắc" />
                            <TableColumn fx:id="colNamSX" prefWidth="80.0" text="Năm SX" />
                            <TableColumn fx:id="colNhienLieu" prefWidth="95.0" text="Nhiên Liệu" />
                            <TableColumn fx:id="colChuXe" prefWidth="170.0" text="Chủ Xe / Khách Hàng" />
                            <TableColumn fx:id="colSDT" prefWidth="115.0" text="Số Điện Thoại" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- 2. Form Chi Tiết & Chỉnh Sửa Hồ Sơ Xe: Card Nền Trắng Phía Phải -->
                <VBox prefWidth="390.0" minWidth="370.0" spacing="12.0"
                      style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">

                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                        <VBox spacing="11.0" style="-fx-padding: 2px 4px 6px 2px;">

                            <!-- Tiêu đề Form -->
                            <HBox alignment="CENTER_LEFT">
                                <Label style="-fx-text-fill: #102A46; -fx-font-weight: 800; -fx-font-size: 16px;"
                                       text="Hồ Sơ &amp; Chi Tiết Xe" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTrangThaiForm"
                                       style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8; -fx-padding: 3px 10px; -fx-background-radius: 10px; -fx-font-size: 11.5px; -fx-font-weight: bold;"
                                       text="Xem chi tiết" />
                            </HBox>

                            <!-- Badge Biển Số Xe Nổi Bật -->
                            <HBox alignment="CENTER"
                                  style="-fx-background-color: #f8fafc; -fx-border-color: #102a46; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px 16px;">
                                <Label fx:id="lblBadgeBienSo"
                                       style="-fx-text-fill: #102a46; -fx-font-size: 20px; -fx-font-weight: 900; -fx-letter-spacing: 1.5px;"
                                       text="CHƯA CHỌN XE" />
                            </HBox>

                            <Separator />

                            <!-- THÔNG TIN PHƯƠNG TIỆN -->
                            <Label style="-fx-text-fill: #102A46; -fx-font-size: 13px; -fx-font-weight: 800;" text="🚗 THÔNG TIN XE" />

                            <!-- Mã Phương Tiện -->
                            <VBox spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="MÃ PHƯƠNG TIỆN" />
                                <TextField fx:id="maPTField" editable="false" promptText="Tự sinh (VD: PT001)"
                                           style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-text-fill: #64748b; -fx-padding: 7px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-font-size: 13.5px;" />
                            </VBox>

                            <!-- Biển Số Xe -->
                            <VBox spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="BIỂN SỐ XE (*)" />
                                <TextField fx:id="bienSoField" promptText="Ví dụ: 51F-123.45"
                                           style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-padding: 7px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-font-size: 13.5px; -fx-font-weight: bold;" />
                            </VBox>

                            <!-- Hãng Xe -->
                            <VBox spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="HÃNG XE (*)" />
                                <ComboBox fx:id="hangXeCombo" maxWidth="Infinity" promptText="Chọn hãng xe"
                                          style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 3px; -fx-font-size: 13px;"
                                          styleClass="light-combo-box" />
                            </VBox>

                            <!-- Dòng / Mẫu Xe -->
                            <VBox spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="DÒNG / MẪU XE (*)" />
                                <TextField fx:id="mauXeField" promptText="Ví dụ: Vios E CVT, City RS, Accent..."
                                           style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-padding: 7px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-font-size: 13.5px;" />
                            </VBox>

                            <!-- Màu Sắc & Năm Sản Xuất (2 Cột) -->
                            <GridPane hgap="10.0" vgap="4.0">
                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="MÀU SẮC" />
                                    <TextField fx:id="mauSacField" promptText="Trắng, Đen, Đỏ..."
                                               style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-padding: 7px 10px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-font-size: 13.5px;" />
                                </VBox>
                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="NĂM SẢN XUẤT" />
                                    <TextField fx:id="namSxField" promptText="2022"
                                               style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-padding: 7px 10px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-font-size: 13.5px;" />
                                </VBox>
                            </GridPane>

                            <!-- Nhiên Liệu -->
                            <VBox spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="NHIÊN LIỆU" />
                                <ComboBox fx:id="nhienLieuCombo" maxWidth="Infinity" promptText="Chọn nhiên liệu"
                                          style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 3px; -fx-font-size: 13px;"
                                          styleClass="light-combo-box" />
                            </VBox>

                            <Separator />

                            <!-- THÔNG TIN CHỦ SỞ HỮU -->
                            <Label style="-fx-text-fill: #102A46; -fx-font-size: 13px; -fx-font-weight: 800;" text="👤 CHỦ SỞ HỮU (KHÁCH HÀNG)" />

                            <!-- Tên Khách Hàng -->
                            <VBox spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="HỌ VÀ TÊN KHÁCH HÀNG" />
                                <TextField fx:id="chuXeField" promptText="Họ và tên chủ sở hữu"
                                           style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-padding: 7px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-font-size: 13.5px;" />
                            </VBox>

                            <!-- SĐT Khách Hàng -->
                            <VBox spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="SỐ ĐIỆN THOẠI" />
                                <TextField fx:id="sdtChuXeField" promptText="090xxxxxxx"
                                           style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-padding: 7px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-font-size: 13.5px;" />
                            </VBox>

                            <!-- Địa Chỉ Khách Hàng -->
                            <VBox spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="ĐỊA CHỈ" />
                                <TextField fx:id="diaChiChuXeField" promptText="Địa chỉ khách hàng"
                                           style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-padding: 7px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-font-size: 13.5px;" />
                            </VBox>

                        </VBox>
                    </ScrollPane>

                    <!-- Nhóm Nút Thao Tác Hành Động -->
                    <VBox spacing="8.0" style="-fx-padding: 6px 0 0 0;">
                        <HBox spacing="10.0">
                            <Button maxWidth="Infinity" onAction="#onThemMoiClick"
                                    style="-fx-background-color: #f47b31; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 9px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(244,123,49,0.3), 8, 0, 0, 2);"
                                    text="➕ Thêm Mới" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#onCapNhatClick"
                                    style="-fx-background-color: #173B61; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 9px; -fx-background-radius: 8px; -fx-cursor: hand;"
                                    text="✏️ Cập Nhật" HBox.hgrow="ALWAYS" />
                        </HBox>

                        <Button maxWidth="Infinity" onAction="#onXemLichSuClick"
                                style="-fx-background-color: #eff6ff; -fx-border-color: #bfdbfe; -fx-text-fill: #1d4ed8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 9px; -fx-background-radius: 8px; -fx-cursor: hand;"
                                text="📋 Xem Lịch Sử Tiếp Nhận &amp; Sửa Chữa" />

                        <Button maxWidth="Infinity" onAction="#onXoaClick"
                                style="-fx-background-color: #fef2f2; -fx-border-color: #fecaca; -fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 9px; -fx-background-radius: 8px; -fx-cursor: hand;"
                                text="🗑️ Xóa Hồ Sơ Xe" />

                        <Button maxWidth="Infinity" onAction="#onXoaTrangClick"
                                style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-size: 12.5px; -fx-cursor: hand;"
                                text="Xóa Trắng Form" />
                    </VBox>
                </VBox>

            </HBox>

        </VBox>
    </HBox>
</VBox>

