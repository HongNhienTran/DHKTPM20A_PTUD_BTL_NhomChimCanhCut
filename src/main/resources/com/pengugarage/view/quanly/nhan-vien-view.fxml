<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.NhanVienController"
      stylesheets="@../../css/style.css"
      styleClass="dark-root"
      prefHeight="760.0" prefWidth="1280.0">

    <!-- Sidebar Quản Lý (Nhúng Component Tái Sử Dụng) -->
    <fx:include source="component/sidebar-quanly.fxml" />

    <!-- Nội dung chính Quản lý nhân viên -->
    <VBox HBox.hgrow="ALWAYS" spacing="18.0" style="-fx-background-color: #0b131f;">
        <padding>
            <Insets bottom="24.0" left="28.0" right="28.0" top="24.0"/>
        </padding>

    <!-- Top Header Bar -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <Button text="← Dashboard" onAction="#onBackToDashboardClick"
                style="-fx-background-color: #16283c; -fx-text-fill: #9ab0c7; -fx-font-weight: bold; -fx-border-color: #223e5f; -fx-border-radius: 6px; -fx-padding: 8px 14px; -fx-cursor: hand;" />
        <VBox spacing="2.0">
            <Label text="Quản Lý Nhân Sự &amp; Tài Khoản (M01-T07 &amp; M01-T08)"
                   style="-fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: 800;" />
            <Label text="Thêm mới, cập nhật, tìm kiếm, khóa/mở trạng thái và quản lý tài khoản nhân viên gara"
                   style="-fx-text-fill: #8c9eb2; -fx-font-size: 12px;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="thongBaoLabel" text=""
               style="-fx-font-size: 13px; -fx-font-weight: bold;" />
    </HBox>

    <!-- Search & Filter Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12.0"
          style="-fx-background-color: #142235; -fx-padding: 14px 18px; -fx-background-radius: 10px; -fx-border-color: #1e354d; -fx-border-radius: 10px;">
        <Label text="🔍" style="-fx-font-size: 14px;" />
        <TextField fx:id="timKiemField" promptText="Tìm theo Mã NV, Họ tên hoặc SĐT..."
                   HBox.hgrow="ALWAYS" styleClass="dark-text-field" />
        
        <Label text="Chức vụ:" style="-fx-text-fill: #8c9eb2; -fx-font-size: 12px;" />
        <ComboBox fx:id="locChucVuCombo" prefWidth="150.0"
                  style="-fx-background-color: #0b1523; -fx-border-color: #203852; -fx-border-radius: 6px; -fx-text-fill: #ffffff;" />

        <Label text="Trạng thái:" style="-fx-text-fill: #8c9eb2; -fx-font-size: 12px;" />
        <ComboBox fx:id="locTrangThaiCombo" prefWidth="150.0"
                  style="-fx-background-color: #0b1523; -fx-border-color: #203852; -fx-border-radius: 6px; -fx-text-fill: #ffffff;" />

        <Button text="Tìm Kiếm" onAction="#onTimKiemClick" styleClass="login-submit-button"
                style="-fx-padding: 9px 18px; -fx-font-size: 12px;" />
        <Button text="Làm Mới" onAction="#onLamMoiClick"
                style="-fx-background-color: #1f3754; -fx-text-fill: #ffffff; -fx-padding: 9px 16px; -fx-background-radius: 8px; -fx-cursor: hand;" />
    </HBox>

    <!-- Main Content: Table + Form Split -->
    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <!-- Bảng danh sách nhân viên -->
        <VBox HBox.hgrow="ALWAYS" spacing="10.0"
              style="-fx-background-color: #142235; -fx-border-color: #1e354d; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 16px;">
            <HBox alignment="CENTER_LEFT">
                <Label text="Danh Sách Nhân Sự Gara" style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 14px;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="tongSoLabel" text="Tổng số: 0 nhân viên" style="-fx-text-fill: #8c9eb2; -fx-font-size: 12px;" />
            </HBox>

            <TableView fx:id="nhanVienTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #0b1523; -fx-border-color: #1e354d; -fx-border-radius: 6px;">
                <columns>
                    <TableColumn fx:id="colMaNV" text="Mã NV" prefWidth="100.0" />
                    <TableColumn fx:id="colHoTen" text="Họ và Tên" prefWidth="180.0" />
                    <TableColumn fx:id="colSDT" text="Số Điện Thoại" prefWidth="120.0" />
                    <TableColumn fx:id="colDiaChi" text="Địa Chỉ" prefWidth="200.0" />
                    <TableColumn fx:id="colChucVu" text="Chức Vụ" prefWidth="130.0" />
                    <TableColumn fx:id="colTrangThai" text="Trạng Thái" prefWidth="110.0" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Form nhập thông tin nhân viên & tài khoản -->
        <VBox prefWidth="380.0" spacing="14.0"
              style="-fx-background-color: #142235; -fx-border-color: #1e354d; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 18px;">
            
            <Label text="Chi Tiết Nhân Sự" style="-fx-text-fill: #f47b31; -fx-font-weight: 800; -fx-font-size: 15px;" />

            <!-- Mã NV -->
            <VBox spacing="4.0">
                <Label text="MÃ NHÂN VIÊN" styleClass="dark-field-label" />
                <TextField fx:id="maNVField" promptText="Hệ thống tự sinh theo chức vụ" editable="false"
                           styleClass="dark-text-field" style="-fx-opacity: 0.8;" />
            </VBox>

            <!-- Họ tên -->
            <VBox spacing="4.0">
                <Label text="HỌ VÀ TÊN (*)" styleClass="dark-field-label" />
                <TextField fx:id="hoTenField" promptText="Nhập họ và tên đầy đủ"
                           styleClass="dark-text-field" />
            </VBox>

            <!-- SĐT -->
            <VBox spacing="4.0">
                <Label text="SỐ ĐIỆN THOẠI (* 10 số)" styleClass="dark-field-label" />
                <TextField fx:id="sdtField" promptText="Ví dụ: 0901234567"
                           styleClass="dark-text-field" />
            </VBox>

            <!-- Địa chỉ -->
            <VBox spacing="4.0">
                <Label text="ĐỊA CHỈ" styleClass="dark-field-label" />
                <TextField fx:id="diaChiField" promptText="Địa chỉ cư trú"
                           styleClass="dark-text-field" />
            </VBox>

            <!-- Chức vụ -->
            <VBox spacing="4.0">
                <Label text="CHỨC VỤ (*)" styleClass="dark-field-label" />
                <ComboBox fx:id="chucVuField" maxWidth="Infinity"
                          style="-fx-background-color: #0b1523; -fx-border-color: #203852; -fx-border-radius: 6px; -fx-text-fill: #ffffff;" />
            </VBox>

            <!-- Action Buttons -->
            <VBox spacing="8.0" style="-fx-padding: 8px 0 0 0;">
                <HBox spacing="10.0">
                    <Button text="Thêm Mới" onAction="#onThemClick" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #10b981; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 6px; -fx-cursor: hand;" />
                    <Button text="Cập Nhật" onAction="#onCapNhatClick" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #f47b31; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 6px; -fx-cursor: hand;" />
                </HBox>

                <Button fx:id="btnKhoaMoKhoa" text="Khóa / Mở Khóa Nhân Viên" onAction="#onDoiTrangThaiClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #dc2626; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 6px; -fx-cursor: hand;" />
                
                <Button text="Tạo / Đổi Mật Khẩu Tài Khoản (M01-T08)" onAction="#onQuanLyTaiKhoanClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #1e3a8a; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 6px; -fx-cursor: hand;" />

                <Button text="Xóa Trắng Form" onAction="#onXoaTrangClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #8c9eb2; -fx-cursor: hand;" />
            </VBox>
        </VBox>
    </HBox>

    </VBox>
</HBox>
