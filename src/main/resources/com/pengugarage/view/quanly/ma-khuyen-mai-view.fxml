<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- MÀN HÌNH QUẢN LÝ MÃ KHUYẾN MÃI (ma-khuyen-mai-view.fxml)             -->
<!-- Tone màu: Light Modern UI, Header đề mục lớn, Sidebar đóng mở,        -->
<!-- Nền vùng làm việc Trắng #FFFFFF / #F8FAFC sáng sủa, dễ quan sát      -->
<!-- ===================================================================== -->

<VBox prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.MaKhuyenMaiController">

    <!-- 1. Thanh Header Quản Lý bên trên (Các đề mục lớn) -->
    <fx:include source="component/header-quanly.fxml" />

    <!-- 2. Thân Trang: Sidebar đóng mở bên trái + Vùng nội dung chính -->
    <HBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

        <!-- Sidebar bên trái -->
        <fx:include source="component/sidebar-quanly.fxml" />

        <!-- Vùng Nội Dung Làm Việc Chính (Nền Trắng #f8fafc) -->
        <VBox spacing="16.0" style="-fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>

            <!-- Top Title & Action Bar -->
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #102A46; -fx-font-size: 24px; -fx-font-weight: 900;"
                           text="Mã Khuyến Mãi &amp; Voucher" />
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;"
                           text="Quản lý chính sách ưu đãi, giảm giá thanh toán và tri ân khách hàng thân thiết" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="thongBaoLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="" />

                <!-- Nút Thêm Mới: Màu Cam Thương Hiệu #F47B31 trích từ logo -->
                <Button onAction="#onThemMoiClick"
                        style="-fx-background-color: #f47b31; -fx-text-fill: #ffffff; -fx-font-weight: 800; -fx-font-size: 12.5px; -fx-padding: 9px 18px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(244,123,49,0.3), 8, 0, 0, 2);"
                        text="➕ Thêm Mã Khuyến Mãi" />
            </HBox>

            <!-- Toolbar Tìm Kiếm & Lọc: Card Nền Trắng (#ffffff) -->
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: #ffffff; -fx-padding: 12px 18px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                <TextField fx:id="timKiemField"
                           promptText="🔍 Tìm theo Mã khuyến mãi..."
                           style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-padding: 8px 16px; -fx-background-radius: 20px; -fx-border-radius: 20px; -fx-font-size: 13px;"
                           HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="locLoaiGiamCombo" prefWidth="170.0" promptText="Loại giảm giá"
                          style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 3px;"
                          styleClass="light-combo-box" />

                <ComboBox fx:id="locTrangThaiCombo" prefWidth="170.0" promptText="Trạng thái"
                          style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 3px;"
                          styleClass="light-combo-box" />

                <Button onAction="#onTimKiemClick"
                        style="-fx-background-color: #173B61; -fx-text-fill: #ffffff; -fx-font-weight: 700; -fx-font-size: 12.5px; -fx-padding: 8px 18px; -fx-background-radius: 8px; -fx-cursor: hand;"
                        text="Tìm Kiếm" />

                <Button graphicTextGap="0.0" onAction="#onLamMoiClick"
                        style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-text-fill: #334155; -fx-padding: 8px 14px; -fx-background-radius: 8px; -fx-cursor: hand;"
                        text="🔄" />
            </HBox>

            <!-- Main Content: Bảng Danh Sách Nền Trắng + Chi Tiết Sổ Phía Dưới -->
            <VBox spacing="12.0" VBox.vgrow="ALWAYS">

                <!-- Card Bảng Danh Sách -->
                <VBox spacing="10.0"
                      style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);"
                      VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: #102A46; -fx-font-weight: 800; -fx-font-size: 15px;"
                               text="Danh Sách Mã Khuyến Mãi Gara" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="tongSoLabel" alignment="CENTER_RIGHT"
                               style="-fx-background-color: #ebf3fa; -fx-text-fill: #173b61; -fx-padding: 4px 12px; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 12px;"
                               text="Tổng số: 0 mã khuyến mãi" />
                    </HBox>

                    <TableView fx:id="khuyenMaiTable" styleClass="light-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMaKM" prefWidth="150.0" text="Mã KM" />
                            <TableColumn fx:id="colLoaiGiam" prefWidth="130.0" text="Loại Giảm" />
                            <TableColumn fx:id="colGiaTriGiam" prefWidth="130.0" text="Mức Giảm" />
                            <TableColumn fx:id="colDonHangToiThieu" prefWidth="150.0" text="Đơn Tối Thiểu" />
                            <TableColumn fx:id="colNgayBatDau" prefWidth="160.0" text="Ngày Bắt Đầu" />
                            <TableColumn fx:id="colNgayHetHan" prefWidth="160.0" text="Ngày Hết Hạn" />
                            <TableColumn fx:id="colSoLuong" prefWidth="110.0" text="Lượt Dùng" />
                            <TableColumn fx:id="colTrangThai" prefWidth="120.0" text="Trạng Thái" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Khung Xem & Chỉnh Sửa Chi Tiết Mã Khuyến Mãi (Card Nền Trắng) -->
                <VBox fx:id="chiTietPanel" spacing="12.0"
                      style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 16px 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                    
                    <!-- Header Panel Chi Tiết -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label style="-fx-text-fill: #102A46; -fx-font-weight: 800; -fx-font-size: 13.5px;"
                               text="CHI TIẾT &amp; CHỈNH SỬA MÃ KHUYẾN MÃI" />
                        <Label fx:id="detailMaKMLabel"
                               style="-fx-background-color: #ebf3fa; -fx-border-color: #bfd7ee; -fx-border-radius: 4px; -fx-text-fill: #173b61; -fx-padding: 3px 10px; -fx-background-radius: 4px; -fx-font-weight: bold; -fx-font-size: 11px;"
                               text="---" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="thongBaoLuuLabel" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="" />
                        <Button onAction="#onDongChiTietClick"
                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand; -fx-padding: 5px 12px;"
                                text="✕ Đóng" />
                    </HBox>

                    <Separator style="-fx-opacity: 0.6;" />

                    <!-- Form Fields Nền Trắng Sáng Sủa -->
                    <VBox spacing="12.0">
                        <!-- Hàng 1: Mã KM + Loại giảm + Giá trị giảm + Đơn tối thiểu -->
                        <HBox spacing="16.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: bold;" text="MÃ KHUYẾN MÃI (*)" />
                                <TextField fx:id="maKMField" promptText="VÍ DỤ: GIAM10, TET2026..."
                                           style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #0F172A; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;" />
                                <Label fx:id="errMaKM" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-font-weight: bold;" text="" visible="false" />
                            </VBox>

                            <VBox prefWidth="180.0" spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: bold;" text="LOẠI GIẢM GIÁ (*)" />
                                <ComboBox fx:id="loaiGiamCombo" maxWidth="Infinity"
                                          style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 3px;"
                                          styleClass="light-combo-box" />
                            </VBox>

                            <VBox prefWidth="180.0" spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: bold;" text="MỨC GIẢM (*)" />
                                <TextField fx:id="giaTriGiamField" promptText="Số tiền hoặc %"
                                           style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #2563eb; -fx-font-weight: bold; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;" />
                                <Label fx:id="errGiaTriGiam" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-font-weight: bold;" text="" visible="false" />
                            </VBox>

                            <VBox prefWidth="200.0" spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: bold;" text="ĐƠN HÀNG TỐI THIỂU (VNĐ)" />
                                <TextField fx:id="giaTriToiThieuField" promptText="0"
                                           style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #0F172A; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;" />
                                <Label fx:id="errGiaTriToiThieu" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-font-weight: bold;" text="" visible="false" />
                            </VBox>
                        </HBox>

                        <!-- Hàng 2: Ngày bắt đầu + Ngày kết thúc + Số lượng + Trạng thái + Nút Lưu -->
                        <HBox alignment="BOTTOM_LEFT" spacing="16.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: bold;" text="NGÀY BẮT ĐẦU (LỊCH CHỌN)" />
                                <DatePicker fx:id="ngayBatDauPicker" maxWidth="Infinity" promptText="dd/MM/yyyy"
                                            style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
                                <Label fx:id="errNgayBatDau" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-font-weight: bold;" text="" visible="false" />
                            </VBox>

                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: bold;" text="NGÀY HẾT HẠN (LỊCH CHỌN)" />
                                <DatePicker fx:id="ngayHetHanPicker" maxWidth="Infinity" promptText="dd/MM/yyyy"
                                            style="-fx-background-radius: 6px; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;" />
                                <Label fx:id="errNgayHetHan" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-font-weight: bold;" text="" visible="false" />
                            </VBox>

                            <VBox prefWidth="130.0" spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: bold;" text="SỐ LƯỢNG LƯỢT DÙNG" />
                                <TextField fx:id="soLuongTonField" promptText="100"
                                           style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #16A34A; -fx-font-weight: bold; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-radius: 6px;" />
                                <Label fx:id="errSoLuongTon" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-font-weight: bold;" text="" visible="false" />
                            </VBox>

                            <VBox prefWidth="170.0" spacing="4.0">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: bold;" text="TRẠNG THÁI" />
                                <ComboBox fx:id="trangThaiCombo" maxWidth="Infinity"
                                          style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 3px;"
                                          styleClass="light-combo-box" />
                            </VBox>

                            <VBox alignment="BOTTOM_CENTER" prefWidth="160.0">
                                <Button maxWidth="Infinity" onAction="#onLuuThayDoiClick"
                                        style="-fx-background-color: #f47b31; -fx-text-fill: #ffffff; -fx-font-weight: 800; -fx-font-size: 12.5px; -fx-padding: 9px 16px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(244,123,49,0.3), 8, 0, 0, 2);"
                                        text="💾 Lưu Thay Đổi" />
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
