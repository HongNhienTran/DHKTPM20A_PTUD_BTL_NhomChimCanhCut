<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ===================================================================== -->
<!-- DASHBOARD QUẢN LÝ GARA (dashboard-view.fxml)                          -->
<!-- Tone màu: Light Modern UI, Header đề mục lớn, Sidebar đóng mở,        -->
<!-- Nền vùng làm việc Trắng #FFFFFF / #F8FAFC sáng sủa, dễ quan sát      -->
<!-- ===================================================================== -->

<VBox prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengugarage.controller.DashboardController">

    <!-- 1. Thanh Header Quản Lý bên trên (Các đề mục lớn) -->
    <fx:include source="component/header-quanly.fxml" />

    <!-- 2. Thân Trang: Sidebar đóng mở bên trái + Vùng nội dung chính -->
    <HBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

        <!-- Sidebar bên trái (Đóng mở linh hoạt) -->
        <fx:include source="component/sidebar-quanly.fxml" />

        <!-- Vùng Nội Dung Làm Việc Chính (Nền Trắng #f8fafc) -->
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc;">

            <!-- Main Dashboard Scrollable Area -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                <VBox spacing="20.0" style="-fx-padding: 24px 28px 36px 28px;">

                    <!-- Title Section -->
                    <VBox spacing="4.0">
                        <Label text="Dashboard Tổng Quan Quản Lý"
                               style="-fx-text-fill: #102A46; -fx-font-size: 24px; -fx-font-weight: 900;" />
                        <Label text="Tổng quan tình hình hoạt động gara, chỉ số doanh thu và trạng thái sửa chữa phương tiện"
                               style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                    </VBox>

                    <!-- ================= 6 KPI CARDS (NỀN CARD TRẮNG #FFFFFF) ================= -->
                    <HBox spacing="14.0">
                        <!-- Card 1: Doanh thu thực thu -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Doanh thu thực thu" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiRevenueLabel" text="117,0 tr đ" style="-fx-text-fill: #102A46; -fx-font-size: 22px; -fx-font-weight: 900;" />
                            <Label text="▲ +12,0% so với 7 ngày trước đó" style="-fx-text-fill: #10b981; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Card 2: Hóa đơn đã thanh toán -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Hóa đơn đã thanh toán" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiInvoiceLabel" text="41" style="-fx-text-fill: #0f172a; -fx-font-size: 22px; -fx-font-weight: 900;" />
                            <Label text="▲ +7,9% TB 2,9 tr đ mỗi hóa đơn" style="-fx-text-fill: #10b981; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Card 3: Lượt tiếp nhận -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Lượt tiếp nhận" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiIntakeLabel" text="34" style="-fx-text-fill: #0f172a; -fx-font-size: 22px; -fx-font-weight: 900;" />
                            <Label text="▲ +17,2% so với 7 ngày trước đó" style="-fx-text-fill: #10b981; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Card 4: Phiếu sửa chữa đang xử lý -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Phiếu sửa chữa đang xử lý" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiRepairLabel" text="13" style="-fx-text-fill: #0f172a; -fx-font-size: 22px; -fx-font-weight: 900;" />
                            <HBox spacing="6.0" alignment="CENTER_LEFT">
                                <Label text="7 chờ • 6 đang sửa"
                                       style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-padding: 3px 8px; -fx-background-radius: 4px; -fx-font-size: 11px; -fx-font-weight: bold;" />
                            </HBox>
                        </VBox>

                        <!-- Card 5: Khách hàng mới -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Khách hàng mới" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiCustomerLabel" text="9" style="-fx-text-fill: #0f172a; -fx-font-size: 22px; -fx-font-weight: 900;" />
                            <Label text="▼ -25,0% so với 7 ngày trước đó" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Card 6: Sản phẩm sắp hết hàng -->
                        <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Sản phẩm sắp hết hàng" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="kpiLowStockLabel" text="2" style="-fx-text-fill: #dc2626; -fx-font-size: 22px; -fx-font-weight: 900;" />
                            <HBox spacing="6.0" alignment="CENTER_LEFT">
                                <Label text="Cần nhập thêm"
                                       style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-padding: 3px 8px; -fx-background-radius: 4px; -fx-font-size: 11px; -fx-font-weight: bold;" />
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- ================= CHARTS SECTION (NỀN CARD TRẮNG #FFFFFF) ================= -->
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        <!-- Khung Biểu Đồ Doanh Thu -->
                        <VBox HBox.hgrow="ALWAYS" prefWidth="640.0" spacing="16.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Doanh thu bán hàng và dịch vụ (7 ngày gần nhất)"
                                   style="-fx-text-fill: #0f172a; -fx-font-size: 16px; -fx-font-weight: 800;" />
                            
                            <!-- Cột biểu đồ -->
                            <HBox alignment="BOTTOM_CENTER" spacing="24.0" prefHeight="220.0" style="-fx-padding: 10px 10px 0 10px;">
                                <!-- T2 -->
                                <VBox alignment="BOTTOM_CENTER" spacing="6.0">
                                    <HBox alignment="BOTTOM_CENTER" spacing="4.0">
                                        <Region prefHeight="45.0" prefWidth="18.0" style="-fx-background-color: #f47b31; -fx-background-radius: 4px 4px 0 0;" />
                                        <Region prefHeight="95.0" prefWidth="18.0" style="-fx-background-color: #173b61; -fx-background-radius: 4px 4px 0 0;" />
                                    </HBox>
                                    <Label text="T2" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                </VBox>
                                <!-- T3 -->
                                <VBox alignment="BOTTOM_CENTER" spacing="6.0">
                                    <HBox alignment="BOTTOM_CENTER" spacing="4.0">
                                        <Region prefHeight="70.0" prefWidth="18.0" style="-fx-background-color: #f47b31; -fx-background-radius: 4px 4px 0 0;" />
                                        <Region prefHeight="115.0" prefWidth="18.0" style="-fx-background-color: #173b61; -fx-background-radius: 4px 4px 0 0;" />
                                    </HBox>
                                    <Label text="T3" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                </VBox>
                                <!-- T4 -->
                                <VBox alignment="BOTTOM_CENTER" spacing="6.0">
                                    <HBox alignment="BOTTOM_CENTER" spacing="4.0">
                                        <Region prefHeight="55.0" prefWidth="18.0" style="-fx-background-color: #f47b31; -fx-background-radius: 4px 4px 0 0;" />
                                        <Region prefHeight="100.0" prefWidth="18.0" style="-fx-background-color: #173b61; -fx-background-radius: 4px 4px 0 0;" />
                                    </HBox>
                                    <Label text="T4" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                </VBox>
                                <!-- T5 -->
                                <VBox alignment="BOTTOM_CENTER" spacing="6.0">
                                    <HBox alignment="BOTTOM_CENTER" spacing="4.0">
                                        <Region prefHeight="85.0" prefWidth="18.0" style="-fx-background-color: #f47b31; -fx-background-radius: 4px 4px 0 0;" />
                                        <Region prefHeight="130.0" prefWidth="18.0" style="-fx-background-color: #173b61; -fx-background-radius: 4px 4px 0 0;" />
                                    </HBox>
                                    <Label text="T5" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                </VBox>
                                <!-- T6 -->
                                <VBox alignment="BOTTOM_CENTER" spacing="6.0">
                                    <HBox alignment="BOTTOM_CENTER" spacing="4.0">
                                        <Region prefHeight="95.0" prefWidth="18.0" style="-fx-background-color: #f47b31; -fx-background-radius: 4px 4px 0 0;" />
                                        <Region prefHeight="150.0" prefWidth="18.0" style="-fx-background-color: #173b61; -fx-background-radius: 4px 4px 0 0;" />
                                    </HBox>
                                    <Label text="T6" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                </VBox>
                                <!-- T7 -->
                                <VBox alignment="BOTTOM_CENTER" spacing="6.0">
                                    <HBox alignment="BOTTOM_CENTER" spacing="4.0">
                                        <Region prefHeight="110.0" prefWidth="18.0" style="-fx-background-color: #f47b31; -fx-background-radius: 4px 4px 0 0;" />
                                        <Region prefHeight="175.0" prefWidth="18.0" style="-fx-background-color: #173b61; -fx-background-radius: 4px 4px 0 0;" />
                                    </HBox>
                                    <Label text="T7" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                </VBox>
                                <!-- CN -->
                                <VBox alignment="BOTTOM_CENTER" spacing="6.0">
                                    <HBox alignment="BOTTOM_CENTER" spacing="4.0">
                                        <Region prefHeight="40.0" prefWidth="18.0" style="-fx-background-color: #f47b31; -fx-background-radius: 4px 4px 0 0;" />
                                        <Region prefHeight="60.0" prefWidth="18.0" style="-fx-background-color: #173b61; -fx-background-radius: 4px 4px 0 0;" />
                                    </HBox>
                                    <Label text="CN" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                </VBox>
                            </HBox>

                            <Label text="Cam: Bán hàng phụ tùng • Xanh Navy: Dịch vụ sửa chữa (triệu đồng)"
                                   style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
                        </VBox>

                        <!-- Khung Trạng Thái Sửa Chữa -->
                        <VBox prefWidth="380.0" spacing="20.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
                            <Label text="Trạng thái tiến độ sửa chữa"
                                   style="-fx-text-fill: #0f172a; -fx-font-size: 16px; -fx-font-weight: 800;" />

                            <VBox spacing="14.0">
                                <!-- Hoàn thành -->
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label text="Hoàn thành"
                                           style="-fx-background-color: #ecfdf5; -fx-text-fill: #059669; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label text="6 (32%)" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                </HBox>

                                <!-- Đang sửa chữa -->
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label text="Đang sửa chữa"
                                           style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label text="6 (32%)" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                </HBox>

                                <!-- Chờ sửa chữa -->
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label text="Chờ sửa chữa"
                                           style="-fx-background-color: #fef9c3; -fx-text-fill: #b45309; -fx-padding: 5px 12px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label text="7 (37%)" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>

    </HBox>

</VBox>
